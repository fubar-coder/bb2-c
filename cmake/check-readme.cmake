# The README of a host program on CLI11 against its help (docs/development.md,
# "Host programs"): the output of PROGRAM -h and of every PROGRAM SUB -h
# occurs verbatim in README (in a fenced code block), and every fenced
# block of README that starts with "Usage: NAME" (NAME the file name of
# PROGRAM) is one of these helps.  Trailing blanks and \r are ignored.
#   cmake -DPROGRAM=... -DREADME=.../README.md [-DSUBCOMMANDS=a,b,...] -P check-readme.cmake
# A failure prints the current help, to be put into the README.
get_filename_component(name ${PROGRAM} NAME)
string(REPLACE "," ";" SUBCOMMANDS "${SUBCOMMANDS}")
if(NOT EXISTS ${README})
	message(FATAL_ERROR "${README}: no such file")
endif()

# TEXT without \r and blanks at the line ends, ending in one newline
function(normalise var text)
	string(REPLACE "\r" "" text "${text}")
	string(REGEX REPLACE "[ \t]+\n" "\n" text "${text}")
	string(REGEX REPLACE "[ \t\n]+$" "" text "${text}")
	set(${var} "${text}\n" PARENT_SCOPE)
endfunction()

file(READ ${README} readme)
normalise(readme "${readme}")

set(helps "")   # no list: the helps hold ';' and '['
set(failed OFF)
set(n 0)
foreach(sub "" ${SUBCOMMANDS})
	if(sub STREQUAL "")
		set(label "${name}")
		execute_process(COMMAND ${PROGRAM} -h RESULT_VARIABLE rc OUTPUT_VARIABLE help ERROR_VARIABLE err)
	else()
		set(label "${name} ${sub}")
		execute_process(COMMAND ${PROGRAM} ${sub} -h RESULT_VARIABLE rc OUTPUT_VARIABLE help ERROR_VARIABLE err)
	endif()
	if(NOT rc EQUAL 0)
		message(FATAL_ERROR "${label} -h: exit status ${rc}, not 0")
	endif()
	normalise(help "${help}")
	set(help_${n} "${help}")
	math(EXPR n "${n} + 1")
	string(FIND "\n${readme}" "\n${help}" at)
	if(at EQUAL -1)
		message(SEND_ERROR "${README}: help of `${label}` is missing or out of date")
		message(NOTICE "The help of `${label}` is now:\n```\n${help}```")
		set(failed ON)
	endif()
endforeach()

# the fenced blocks of the README that start with "Usage: NAME"
set(rest "${readme}")
set(block "")
set(in_block OFF)
while(NOT rest STREQUAL "")
	string(FIND "${rest}" "\n" nl)
	string(SUBSTRING "${rest}" 0 ${nl} line)
	math(EXPR nl "${nl} + 1")
	string(SUBSTRING "${rest}" ${nl} -1 rest)
	if(line MATCHES "^```")
		if(in_block)
			set(in_block OFF)
			string(FIND "${block}" "Usage: ${name}" at)
			if(at EQUAL 0)
				set(found OFF)
				math(EXPR last "${n} - 1")
				foreach(i RANGE ${last})
					if(block STREQUAL help_${i})
						set(found ON)
					endif()
				endforeach()
				if(NOT found)
					string(REGEX REPLACE "\n.*" "" first "${block}")
					message(SEND_ERROR "${README}: usage block `${first}` is no longer printed by ${name}")
					set(failed ON)
				endif()
			endif()
		else()
			set(in_block ON)
			set(block "")
		endif()
	elseif(in_block)
		string(APPEND block "${line}\n")
	endif()
endwhile()
if(failed)
	message(FATAL_ERROR "${README} does not match the help of ${name}")
endif()
