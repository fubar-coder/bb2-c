# The order of the bug-orig tests (cmake/bug-orig-order.cmake): in the
# order ctest has them (`ctest --show-only=json-v1`, the declaration order)
# the tests with the label LABEL must have a COST that never grows.
#   cmake -DBUILD=<build dir> -DLABEL=bug-orig -P check-test-order.cmake
#   cmake -DJSON=<file of ctest --show-only=json-v1> -DLABEL=... -P ...
if(NOT LABEL OR (NOT BUILD AND NOT JSON))
	message(FATAL_ERROR "usage: cmake (-DBUILD=DIR | -DJSON=FILE) -DLABEL=NAME -P check-test-order.cmake")
endif()
if(JSON)
	file(READ ${JSON} json)
else()
	execute_process(COMMAND ${CMAKE_CTEST_COMMAND} --show-only=json-v1 -L ${LABEL}
		WORKING_DIRECTORY ${BUILD} OUTPUT_VARIABLE json RESULT_VARIABLE r)
	if(r)
		message(FATAL_ERROR "ctest --show-only=json-v1 failed in ${BUILD}")
	endif()
endif()

# every lookup parses its whole input: the tests apart first, then each
# test's properties on their own
string(JSON tests GET "${json}" tests)
string(JSON ntests LENGTH "${tests}")
set(prev "")
set(prev_name "")
set(n 0)
if(ntests GREATER 0)
	math(EXPR last "${ntests} - 1")
	foreach(i RANGE ${last})
		string(JSON test GET "${tests}" ${i})
		string(JSON name GET "${test}" name)
		string(JSON props ERROR_VARIABLE err GET "${test}" properties)
		set(cost "")
		set(labels "")
		if(NOT err)
			string(JSON nprops LENGTH "${props}")
		endif()
		if(NOT err AND nprops GREATER 0)
			math(EXPR plast "${nprops} - 1")
			foreach(j RANGE ${plast})
				string(JSON pname GET "${props}" ${j} name)
				if(pname STREQUAL "COST")
					string(JSON cost GET "${props}" ${j} value)
				elseif(pname STREQUAL "LABELS")
					string(JSON nl LENGTH "${props}" ${j} value)
					if(nl GREATER 0)
						math(EXPR llast "${nl} - 1")
						foreach(k RANGE ${llast})
							string(JSON l GET "${props}" ${j} value ${k})
							list(APPEND labels "${l}")
						endforeach()
					endif()
				endif()
			endforeach()
		endif()
		if(NOT LABEL IN_LIST labels)
			continue()
		endif()
		if(cost STREQUAL "")
			message(FATAL_ERROR "test order: ${name} (label ${LABEL}) has no COST")
		endif()
		if(NOT prev STREQUAL "" AND cost GREATER prev)
			message(FATAL_ERROR "test order: ${name} (COST ${cost}) is declared after "
				"${prev_name} (COST ${prev}): the tests with the label ${LABEL} must be "
				"declared with the largest COST first (cmake/bug-orig-order.cmake)")
		endif()
		set(prev ${cost})
		set(prev_name ${name})
		math(EXPR n "${n} + 1")
	endforeach()
endif()
if(n EQUAL 0)
	message(FATAL_ERROR "test order: no test with the label ${LABEL}")
endif()
message(STATUS "test order: ${n} tests with the label ${LABEL}, the largest COST first")
