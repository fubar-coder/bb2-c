# -h / --help of the Amiga programs (test tools) in Amiberry: for each, exit
# status 0 and the usage text on stdout (cmake/check-help.cmake for the host).
#   cmake -DAMIGA_RUN=... -DWORK=DIR "-DPROGRAMS=PATH;..." -P check-help-amiga.cmake
# 77 (skipped) without the emulator.
set(test ${WORK}/test)
file(REMOVE_RECURSE ${WORK})
file(MAKE_DIRECTORY ${test})
set(script "")
foreach(p IN LISTS PROGRAMS)
	get_filename_component(name ${p} NAME)
	file(COPY ${p} DESTINATION ${test})
	foreach(opt --help -h)
		string(APPEND script "TEST:${name} ${opt} >TEST:${name}${opt}.txt\n"
			"Echo \"rc=$RC\" >>TEST:${name}${opt}.txt\n")
	endforeach()
endforeach()
file(WRITE ${WORK}/run.script "${script}")
execute_process(COMMAND ${AMIGA_RUN} --timeout 60 --dir ${WORK} ${WORK}/run.script
	RESULT_VARIABLE rc)
if(rc EQUAL 77)
	cmake_language(EXIT 77)
endif()
if(rc)
	message(FATAL_ERROR "help: the emulator run failed (${WORK})")
endif()
set(bad 0)
foreach(p IN LISTS PROGRAMS)
	get_filename_component(name ${p} NAME)
	foreach(opt --help -h)
		set(out "")
		if(EXISTS ${test}/${name}${opt}.txt)
			file(READ ${test}/${name}${opt}.txt out)
		endif()
		if(NOT out MATCHES "^usage: [^\n]*\n.*rc=0[\r\n]*$")
			message("${name} ${opt}: no usage text or exit status not 0:\n${out}")
			math(EXPR bad "${bad} + 1")
		endif()
	endforeach()
endforeach()
if(bad)
	message(FATAL_ERROR "help: ${bad} failures")
endif()
