# clangd configuration - GENERATED by CMake from cmake/clangd.in (not in git;
# paths of this machine's toolchain: @AMIGA_TOOLCHAIN_PREFIX@, gcc @AMIGA_GCC_MAJOR@).
#
# Compile commands come from the CMake build (CMAKE_EXPORT_COMPILE_COMMANDS),
# @CLANGD_DATABASE@/compile_commands.json; headers get the command of a
# matching .c.
#
# clangd parses the sources as m68k AmigaOS.  The real build uses
# m68k-amigaos-gcc; clang does not know that triple and would fall back to
# x86_64 ("unknown register name 'a6'", host headers).  gcc-only options of
# the database are removed.  _NO_INLINE: clang cannot parse the bebbo
# inline/*.h (fp0 clobbers, varargs macros), so code insight uses the
# clib/*_protos.h prototypes.
#
# CLion: its clangd engine takes the compile flags from the CMake project
# model, not from CompileFlags here.
If:
  PathExclude: (tools|host|programs/ted/tests/host)/.*
CompileFlags:
  CompilationDatabase: @CLANGD_DATABASE@
  Compiler: clang
  Remove: [-m68000, -m68020, -noixemul, -fomit-frame-pointer, -fbaserel, -mcrt=*, -msmall-code,
           -fno-tree-loop-distribute-patterns]
  Add:
    - --target=m68k-unknown-linux
    - -m68020
    - -mhard-float
    - -nostdinc
    - -D__amigaos__
    - -Dmc68000
    - -D_NO_INLINE
    - -D__stdargs=
    - -D__regargs=
    - -D__saveds=
    - -D__chip=
    - -I@AMIGA_TOOLCHAIN_PREFIX@/m68k-amigaos/libnix/include
    - -I@AMIGA_TOOLCHAIN_PREFIX@/lib/gcc/m68k-amigaos/@AMIGA_GCC_MAJOR@/include
    - -I@AMIGA_TOOLCHAIN_PREFIX@/m68k-amigaos/ndk-include
    - -I@AMIGA_TOOLCHAIN_PREFIX@/m68k-amigaos/sys-include
    - -I@AMIGA_TOOLCHAIN_PREFIX@/m68k-amigaos/include
---
# the host side (tools/, host tests; native compiler): its own build directory
If:
  PathMatch: (tools|host|programs/ted/tests/host)/.*
CompileFlags:
  CompilationDatabase: @CLANGD_DATABASE@/host
