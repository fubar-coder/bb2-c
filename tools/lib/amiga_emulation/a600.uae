; A600 configuration of the test emulator (tools/lib/amiga_emulation,
; machine "a600").  Taken from the user's "A600.uae" (Amiberry 8.5.0):
; only the machine; host paths, sound card, GUI, window and RTG settings
; removed.  @EMULATION_DIR@ is <repo>/amiga-emulation; TEST: and
; everything else a test needs is added by the library.
; A600 (Gayle, IDE, PCMCIA), ECS, 68000 with 24-bit addressing, not
; cycle-exact, 2 MB chip (chipmem_size=4), 1 MB slow (bogomem_size=4), no
; fast memory (Zorro II fast RAM together with a Zorro II RTG card crashes
; Amiberry 8.5.0 at the start), Kickstart 3.1 (40.63, the A500/A600/A2000
; ROM, Amiga Forever's amiga-os-310-a600.rom), the Workbench 3.1 hardfile
; of the a1200, read-only.
config_hardware=true
config_host=true
config_version=8.5.0
use_gui=no
use_debugger=false
kickstart_rom_file=@EMULATION_DIR@/amiga-os-310-a600.rom
pcmcia_mb_rom_file=:ENABLED
ide_mb_rom_file=:ENABLED
flash_file=
cart_file=
rtc_file=
kickshifter=false
scsidevice_disable=false
floppy_volume=33
floppy0=
floppy1=
floppy1type=-1
floppy2=
floppy3=
nr_floppies=1
floppy_speed=100
cd_speed=100
serial_on_demand=false
serial_hardware_ctsrts=true
serial_status=true
serial_direct=false
scsi=false
uaeserial=false
sana2=false
sound_output=interrupts
sound_channels=stereo
sound_stereo_separation=7
sound_stereo_mixing_delay=0
sound_max_buff=3072
sound_frequency=44100
sound_interpol=anti
sound_filter=emulated
sound_filter_type=standard
sound_volume=0
sound_volume_paula=0
sound_volume_cd=0
sound_volume_ahi=0
sound_volume_midi=0
sound_volume_genlock=0
sound_auto=false
sound_stereo_swap_paula=false
sound_stereo_swap_ahi=false
cachesize=0
joyport0=mouse
joyport0autofire=none
joyportfriendlyname0=System mouse
joyportname0=MOUSE0
joyport1=none
joyport1autofire=none
bsdsocket_emu=false
synchronize_clock=false
maprom=0x0
gfx_framerate=1
gfx_resolution=hires
gfx_linemode=double2
gfx_fullscreen_amiga=false
gfx_fullscreen_picasso=false
gfx_colour_mode=32bit
gfx_api=sdl3
gfx_api_options=hardware
immediate_blits=false
ntsc=false
genlock=false
chipset=ecs
chipset_refreshrate=50.000282
collision_level=full
chipset_compatible=A600
display_optimizations=full
rtc=MSM6242B
cia_overlay=false
ksmirror_a8=true
pcmcia=true
resetwarning=false
cia_todbug=true
ciaa_type=391078-01
ciab_type=391078-01
eclocksync=Gayle
ide=a600/a1200
fastmem_size=0
debugmem_start=0x0
debugmem_size=0
mem25bit_size=0
a3000mem_size=0
mbresmem_size=0
z3mem_size=0
z3mem_start=0x40000000
bogomem_size=4
chipmem_size=4
cpu_speed=max
cpu_throttle=0.0
cpu_type=68000
cpu_model=68000
cpu_compatible=true
cpu_24bit_addressing=true
cpu_data_cache=false
cpu_cycle_exact=false
cpu_memory_cycle_exact=false
blitter_cycle_exact=false
cycle_exact=false
fpu_strict=false
debug_mem=false
log_illegal_mem=false
kbd_lang=us
hardfile2=ro,DH0:@EMULATION_DIR@/workbench-311.hdf,32,1,2,512,0,,uae0
uaehf0=hdf,ro,DH0:@EMULATION_DIR@/workbench-311.hdf,32,1,2,512,0,,uae0
input.config=0
input.joymouse_speed_analog=25
input.joymouse_speed_digital=10
input.joymouse_deadzone=33
input.joystick_deadzone=33
input.analog_joystick_multiplier=18
input.analog_joystick_offset=-5
input.mouse_speed=100
input.autofire_speed=600
input.autoswitch=true
