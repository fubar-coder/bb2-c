; Standard configuration of the test emulator (tools/lib/amiga_emulation).
; Taken from the user's A1200-AB3-AGA.uae (Amiberry 8.4.2), host-specific
; lines removed.  @EMULATION_DIR@ is <repo>/amiga-emulation; TEST: and
; everything else a test needs is added by the library.  Tests change it
; only by key=value differences (e.g. the RTG variant, AMIGA-EMULATION-SETUP.md).
; A1200, AGA, 68020/68882, 8 MB chip, 128 MB Z3 fast, Kickstart 3.2 (47.115);
; Workbench in PAL HighRes Laced, 256 colours, hardfile read-only.
config_hardware=true
config_host=true
config_version=8.4.2
use_gui=no
use_debugger=false
kickstart_rom_file=@EMULATION_DIR@/A1200.47.115.rom
kickstart_rom_file_id=B18D3B67,KS ROM v3.2.3 (A1200)
pcmcia_mb_rom_file=:ENABLED
ide_mb_rom_file=:ENABLED
cart_file=
kickshifter=false
scsidevice_disable=false
floppy_volume=33
floppy0=
floppy1=
floppy1type=-1
floppy2=
floppy3=
nr_floppies=1
floppy_speed=100
cd_speed=100
parallel_on_demand=false
