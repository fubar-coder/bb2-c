# ctest rwe_resident_*: the contents of a resident blitzres made (RES)
# equal those of EXPECT (types, macros, constants as blitzres --dump
# prints them: the unused bytes of the nodes left out).  Exit 77
# (skipped) if EXPECT is missing.
#   cmake -DBLITZRES=... -DRES=... -DEXPECT=... -P check.cmake
if(NOT EXISTS ${EXPECT})
	message(STATUS "no ${EXPECT}: skipped")
	cmake_language(EXIT 77)
endif()
foreach(f RES EXPECT)
	execute_process(COMMAND ${BLITZRES} --dump ${${f}} OUTPUT_VARIABLE dump_${f}
		RESULT_VARIABLE rc)
	if(rc)
		message(FATAL_ERROR "blitzres --dump ${${f}}: exit ${rc}")
	endif()
endforeach()
if(NOT dump_RES STREQUAL dump_EXPECT)
	string(REPLACE "\n" ";" a "${dump_EXPECT}")
	string(REPLACE "\n" ";" b "${dump_RES}")
	foreach(l IN LISTS a)
		if(NOT l IN_LIST b)
			message("only in ${EXPECT}: ${l}")
		endif()
	endforeach()
	foreach(l IN LISTS b)
		if(NOT l IN_LIST a)
			message("only in ${RES}: ${l}")
		endif()
	endforeach()
	message(FATAL_ERROR "the contents of ${RES} differ from ${EXPECT} (order or entries)")
endif()
string(REGEX MATCHALL "\n" lines "${dump_RES}")
list(LENGTH lines n)
message(STATUS "${n} entries, the same as ${EXPECT}")
