# The NDK functions with a parameter in a3, a4 or a5 (the inline headers
# of the toolchain's NDK) and how the libraries call them
# (cmake/ndk-calls.cmake; docs/libs/cmdlibs-port.md, "OS calls with a
# parameter in a3, a4 or a5").  The libraries are compiled with
# -ffixed-a3/a4/a5: a3 is the Blitz program's string pointer, a4 the base
# of its locals, a5 of its globals, and gcc saves no fixed register around
# an __asm block, so the NDK's macro of such a function returns with the
# register changed.
#
# HEADER (inline/HEADER.h)  NAME  REGS (the parameters' registers)  STATE:
#   safe      safe/HEADER.h redefines __NAME_base with the register saved
#             around the call
#   poisoned  a call in a library does not compile
#   native    the NDK saves the register itself (a5)
#   pending   neither, only until the safe forms are written
#
# HEADER    NAME                     REGS   STATE
bsdsocket  getaddrinfo              a3     poisoned
bsdsocket  gethostbyaddr_r          a3     poisoned
bsdsocket  gethostbyname_r          a3     poisoned
bsdsocket  WaitSelect               a3     poisoned
datatypes  DoDTMethodA              a3     poisoned
datatypes  PrintDTObjectA           a3     poisoned
datatypes  RefreshDTObjectA         a3     poisoned
datatypes  SaveDTObjectA            a3,a4  poisoned
datatypes  SetDTAttrsA              a3     poisoned
exec       AddTask                  a3     poisoned
exec       RawDoFmt                 a3     poisoned
exec       Supervisor               a5     native
gadtools   GT_GetGadgetAttrsA       a3     pending
gadtools   GT_SetGadgetAttrsA       a3     pending
graphics   AttemptLockLayerRom      a5     native
graphics   ChangeExtSpriteA         a3     safe
graphics   FindColor                a3     poisoned
graphics   LockLayerRom             a5     native
graphics   TextFit                  a3     safe
graphics   UnlockLayerRom           a5     native
icon       DrawIconStateA           a3     poisoned
icon       GetIconRectangleA        a3,a4  poisoned
intuition  AutoRequest              a3     safe
intuition  BuildEasyRequestArgs     a3     poisoned
intuition  BuildSysRequest          a3     poisoned
intuition  DoGadgetMethodA          a3     poisoned
intuition  EasyRequestArgs          a3     safe
intuition  SetGadgetAttrsA          a3     poisoned
layers     CreateBehindHookLayer    a3     poisoned
layers     CreateUpfrontHookLayer   a3     poisoned
layout     LayoutLimits             a3     poisoned
layout     RefreshPageGadget        a3     poisoned
layout     SetPageGadgetAttrsA      a3,a4  poisoned
locale     FormatDate               a3     poisoned
locale     FormatString             a3     poisoned
locale     ParseDate                a3     poisoned
virtual    RefreshVirtualGadget     a3     poisoned
virtual    RethinkVirtualSize       a3     poisoned
wb         AddAppIconA              a3,a4  safe
