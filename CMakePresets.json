{
	"version": 6,
	"configurePresets": [
		{
			"name": "amiga",
			"displayName": "AmigaOS, 68000, release",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/amiga",
			"toolchainFile": "${sourceDir}/cmake/m68k-amigaos.cmake",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
		},
		{
			"name": "amiga-debug",
			"displayName": "AmigaOS, 68000, release code with symbols",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/amiga-debug",
			"toolchainFile": "${sourceDir}/cmake/m68k-amigaos.cmake",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_C_FLAGS_DEBUG": "-Os -g" }
		}
	],
	"buildPresets": [
		{ "name": "amiga", "configurePreset": "amiga" },
		{ "name": "amiga-debug", "configurePreset": "amiga-debug" }
	],
	"testPresets": [
		{ "name": "host", "displayName": "Tests on the host, without emulator",
		  "configurePreset": "amiga", "output": { "outputOnFailure": true },
		  "filter": { "exclude": { "label": "emulator" } } },
		{ "name": "emulator", "displayName": "Tests in Amiberry",
		  "configurePreset": "amiga", "output": { "outputOnFailure": true },
		  "filter": { "include": { "label": "emulator" } } },
		{ "name": "all", "displayName": "All tests",
		  "configurePreset": "amiga", "output": { "outputOnFailure": true } }
	]
}
