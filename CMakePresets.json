{
	"version": 6,
	"cmakeMinimumRequired": { "major": 4, "minor": 2, "patch": 3 },
	"configurePresets": [
		{
			"name": "amiga",
			"displayName": "AmigaOS, 68000, release",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/amiga",
			"toolchainFile": "${sourceDir}/cmake/m68k-amigaos.cmake",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
		},
		{
			"name": "amiga-debug",
			"displayName": "AmigaOS, 68000, release code with symbols",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/amiga-debug",
			"toolchainFile": "${sourceDir}/cmake/m68k-amigaos.cmake",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_C_FLAGS_DEBUG": "-Os -g" }
		},
		{
			"name": "amiga-cov",
			"displayName": "AmigaOS, 68000, release, blitz2 with function coverage (TEST:cov), host side with gcov",
			"inherits": "amiga",
			"binaryDir": "${sourceDir}/build/amiga-cov",
			"cacheVariables": { "BLITZ2_COVERAGE": "ON", "HOST_COVERAGE": "ON" }
		},
		{
			"name": "native",
			"displayName": "Host side only (tools, host tests), native compiler, debug - for IDEs",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/native",
			"cacheVariables": { "BLITZ2_HOST": "ON", "CMAKE_BUILD_TYPE": "Debug" }
		}
	],
	"buildPresets": [
		{ "name": "amiga", "configurePreset": "amiga" },
		{ "name": "amiga-debug", "configurePreset": "amiga-debug" },
		{ "name": "amiga-cov", "configurePreset": "amiga-cov" },
		{ "name": "native", "configurePreset": "native" }
	],
	"testPresets": [
		{ "name": "native", "displayName": "Host tests of the native profile, without emulator",
		  "configurePreset": "native",
		  "output": { "outputOnFailure": true, "outputJUnitFile": "junit-native.xml",
		              "maxPassedTestOutputSize": 1048576, "maxFailedTestOutputSize": 1048576,
		              "testOutputTruncation": "tail" },
		  "filter": { "exclude": { "label": "emulator|oracle" } } },
		{ "name": "host", "displayName": "Tests on the host, without emulator",
		  "configurePreset": "amiga",
		  "output": { "outputOnFailure": true, "outputJUnitFile": "junit-host.xml",
		              "maxPassedTestOutputSize": 1048576, "maxFailedTestOutputSize": 1048576,
		              "testOutputTruncation": "tail" },
		  "filter": { "exclude": { "label": "emulator|oracle|bug-orig|bug-port" } } },
		{ "name": "emulator", "displayName": "Tests in Amiberry",
		  "configurePreset": "amiga",
		  "output": { "outputOnFailure": true, "outputJUnitFile": "junit-emulator.xml",
		              "maxPassedTestOutputSize": 1048576, "maxFailedTestOutputSize": 1048576,
		              "testOutputTruncation": "tail" },
		  "environment": { "AMIGA_EMULATION_TIMEOUT_STATE": "1", "AMIGA_EMULATION_LOG": "1" },
		  "execution": { "jobs": 4 },
		  "filter": { "include": { "label": "emulator" }, "exclude": { "label": "oracle|bug-orig|bug-port" } } },
		{ "name": "all", "displayName": "All tests",
		  "configurePreset": "amiga",
		  "output": { "outputOnFailure": true, "outputJUnitFile": "junit-all.xml",
		              "maxPassedTestOutputSize": 1048576, "maxFailedTestOutputSize": 1048576,
		              "testOutputTruncation": "tail" },
		  "environment": { "AMIGA_EMULATION_TIMEOUT_STATE": "1", "AMIGA_EMULATION_LOG": "1" },
		  "execution": { "jobs": 4 },
		  "filter": { "exclude": { "label": "oracle|bug-orig|bug-port" } } },
		{ "name": "oracle", "displayName": "AmiBlitz3's own compiler as oracle for the expect files of tests/ab3 (ab3_cli_ref)",
		  "configurePreset": "amiga",
		  "output": { "outputOnFailure": true, "outputJUnitFile": "junit-oracle.xml",
		              "maxPassedTestOutputSize": 1048576, "maxFailedTestOutputSize": 1048576,
		              "testOutputTruncation": "tail" },
		  "environment": { "AMIGA_EMULATION_TIMEOUT_STATE": "1", "AMIGA_EMULATION_LOG": "1" },
		  "execution": { "jobs": 4 },
		  "filter": { "include": { "label": "oracle" } } },
		{ "name": "bug-orig","displayName": "Reproduced original bugs (fail on purpose)",
		  "configurePreset": "amiga",
		  "output": { "outputOnFailure": true, "outputJUnitFile": "junit-bug-orig.xml",
		              "maxPassedTestOutputSize": 1048576, "maxFailedTestOutputSize": 1048576,
		              "testOutputTruncation": "tail" },
		  "environment": { "AMIGA_EMULATION_TIMEOUT_STATE": "1", "AMIGA_EMULATION_LOG": "1" },
		  "execution": { "jobs": 4 },
		  "filter": { "include": { "label": "bug-orig|bug-port" } } },
		{ "name": "coverage", "displayName": "All tests and the original bugs with the coverage compilers (coverage/ per test)",
		  "configurePreset": "amiga-cov",
		  "output": { "outputOnFailure": true, "outputJUnitFile": "junit-coverage.xml",
		              "maxPassedTestOutputSize": 1048576, "maxFailedTestOutputSize": 1048576,
		              "testOutputTruncation": "tail" },
		  "environment": { "AMIGA_EMULATION_TIMEOUT_STATE": "1", "AMIGA_EMULATION_LOG": "1" },
		  "execution": { "jobs": 4 } }
	]
}
