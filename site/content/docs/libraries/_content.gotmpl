{{- /*
  The command reference: one page per library, made from the command
  tables in data/libraries/GROUP/NAME.json (generated from the built
  library files by blitzlib cmdref and checked by the build; see
  site/README.md). The Markdown comes from the partials in
  layouts/_partials/cmdref/.

  A hand-written description and introduction of a library, if there is
  one: data/libintros/GROUP/NAME.yaml with the keys "description" (one
  sentence, for lists and search) and "intro" (Markdown, shown above the
  commands).

  The fixed original bugs of a library (data/fixoverview.yaml) are linked
  from the page and from its commands (layouts/_partials/cmdref/fixes.html).

  Hand-written descriptions of single commands, if there are any:
  data/cmddesc/GROUP/NAME.yaml, keyed by the command's name, each with
  "text" (one or two sentences, shown under the command's heading) and
  optionally "notes" (Markdown, shown after its forms).
*/ -}}
{{- $intros := hugo.Data.libintros | default dict -}}
{{- $cmddescs := hugo.Data.cmddesc | default dict -}}

{{- /* The fixed original bugs of each library, from data/fixoverview.yaml
  (site/README.md): a row concerns every library its "library" names; the
  rows of the page of the AmigaOS calls are of deflibs libraries, the
  others of command libraries and userlibs. */ -}}
{{- $fixes := dict -}}
{{- $osfixes := dict -}}
{{- range hugo.Data.fixoverview.rows -}}
  {{- $row := . -}}
  {{- range split .library "," -}}
    {{- $name := trim . " " -}}
    {{- if eq $row.page "libraries/amigaos" -}}
      {{- $osfixes = merge $osfixes (dict $name ((index $osfixes $name | default slice) | append $row)) -}}
    {{- else -}}
      {{- $fixes = merge $fixes (dict $name ((index $fixes $name | default slice) | append $row)) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* command libraries (acidlibs) and userlibs: one page each */ -}}
{{- range $group, $section := dict "acidlibs" "commands" "userlibs" "userlibs" -}}
  {{- $groupintros := index $intros $group | default dict -}}
  {{- range $name, $lib := index hugo.Data.libraries $group -}}
    {{- $intro := index $groupintros $name | default dict -}}
    {{- $n := len (where $lib.entries "kind" "in" (slice "statement" "function" "command")) -}}
    {{- $desc := printf "The %d commands of %s, with their forms and argument types." $n $name -}}
    {{- $descs := index (index $cmddescs $group | default dict) $name | default dict -}}
    {{- $content := partial "cmdref/commands.html" (dict "lib" $lib "intro" $intro.intro "descs" $descs
      "fixes" (index $fixes $name) "fixpage" (printf "libraries/%s/%s" $section $name)) -}}
    {{- $.AddPage (dict
      "path" (printf "%s/%s" $section $name)
      "title" $name
      "description" ($intro.description | default $desc)
      "params" (dict
        "cmdref" (dict "number" $lib.number "count" $n "about" ($intro.description | default "")))
      "content" (dict "mediaType" "text/markdown" "value" $content)) -}}
  {{- end -}}
{{- end -}}

{{- /* AmigaOS libraries (deflibs): one page per library or resource that
  a deflibs library opens, with the calls of every deflibs library that
  uses its base */ -}}
{{- $deflibs := hugo.Data.libraries.deflibs -}}
{{- $groupintros := index $intros "deflibs" | default dict -}}
{{- range $name, $lib := $deflibs -}}
  {{- with $lib.opens -}}
    {{- $intro := index $groupintros $name | default dict -}}
    {{- $calls := slice -}}
    {{- $numbers := slice -}}
    {{- range sort $deflibs "number" "desc" -}}
      {{- with where .entries "base" $lib.number -}}
        {{- $calls = $calls | append . -}}
      {{- end -}}
      {{- if where .entries "base" $lib.number -}}
        {{- $numbers = $numbers | append .number -}}
      {{- end -}}
    {{- end -}}
    {{- $n := len $calls -}}
    {{- $desc := printf "The %d calls of %s that a program can use directly, with their registers." $n . -}}
    {{- $content := partial "cmdref/oscalls.html" (dict "lib" $lib "calls" $calls "numbers" $numbers "intro" $intro.intro
      "fixes" (index $osfixes $name)) -}}
    {{- $.AddPage (dict
      "path" (printf "amigaos/%s" $name)
      "title" .
      "description" ($intro.description | default $desc)
      "params" (dict
        "cmdref" (dict "number" $lib.number "count" $n "about" ($intro.description | default "")))
      "content" (dict "mediaType" "text/markdown" "value" $content)) -}}
  {{- end -}}
{{- end -}}
