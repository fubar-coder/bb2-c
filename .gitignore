# build output (CMake presets and IDE profiles)
build/
cmake-build-*/
.idea/
# generated by CMake (cmake/clangd.in)
.clangd
# emulation data (Kickstart ROM, hardfiles): local only, see amiga-emulation/README.md
/amiga-emulation/*
!/amiga-emulation/.gitkeep
!/amiga-emulation/README.md
# downloaded originals (cmake/fetch-originals.cmake), see archive/README.md
/.cache
/archive/cd
/archive/aminet
/archive/amiblitz3

# Claude Code: agent definitions are in git, the rest is local
/.claude/worktrees/
/.claude/settings.local.json
# created by `openspec init` / `openspec update` (README, "Structure")
/.claude/commands/
/.claude/skills/
