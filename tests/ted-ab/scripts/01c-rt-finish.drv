; Test 01 (K bui5/makefile/includes/finish_mouse.bb): round trip - load, SAVE over the file (file requester
; prefilled with the loaded path/name), QUIT.  Compared: saved file (= the
; original, @roundtrip), .bak (= the original), .xtra, .info, dump, requesters.
; @source K bui5/makefile/includes/finish_mouse.bb
; @roundtrip
; @est 3
; @expect exists finish_mouse.bb.info
; @expect exists finish_mouse.bb.xtra
timeout 10
wait req "OKEE DOKEE"
gad 1
wait screen
dump start
menu 0 2
wait freq "Name to save file as"
freq ok
wait screen
dump saved
menu 0 9
wait exit
