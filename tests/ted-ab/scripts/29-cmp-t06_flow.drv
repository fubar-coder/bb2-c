; Stage 2b compile through the menu (generated once by bb2 gen2b.py): corpus t06_flow
; CREATE EXECUTABLE without runtime errors; = the corpus ref run (tests/corpus)
; @source T t06_flow
; @xtra norunerr
; @expect corpus t06_flow t06_flow
; @expect same t06_flow.bb2
; @est 4
timeout 10
wait req "OKEE DOKEE"
gad 1
wait screen
menu 4 2
wait freq "Name of Executable to create"
timeout 30
freq ok "t06_flow" "TEDRUN:work"  ; @ignore compilewindow
timeout 10
wait screen
menu 0 9
wait exit
