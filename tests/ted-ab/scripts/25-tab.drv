; Stage 2b: BLOCK TAB, BLOCK UNTAB (removes the leading spaces BLOCK TAB added),
; MARK INDENT on lines 1-3, SAVE.
; @source T t04_arr
; @expect bak t04_arr.bb2.bak
; @expect exists t04_arr.bb2
; @est 6
timeout 10
wait req "OKEE DOKEE"
gad 1
wait screen
key 4d
key 50
key 4d
key 4d
key 4d
key 51
menu 1 9
dump tab
menu 1 10
dump untab
menu 1 11
dump indent
menu 0 2
wait freq "Name to save file as"
freq ok
wait screen
menu 0 9
wait exit
