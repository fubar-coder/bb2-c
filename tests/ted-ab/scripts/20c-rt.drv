; Stage 2b round trip (generated once by bb2 gen2b.py): CD internet/manual_source/blitz_manual/18.sound/trackerexample.bb2
; load, SAVE over the file, QUIT; saved file and .bak = original
; @source K internet/manual_source/blitz_manual/18.sound/trackerexample.bb2
; @roundtrip
; @expect exists trackerexample.bb2.info
; @est 3
timeout 30
wait req "OKEE DOKEE"
gad 1
wait screen
dump start
menu 0 2
wait freq "Name to save file as"
freq ok
wait screen
dump saved
menu 0 9
wait exit
