; Stage 2b round trip (generated once by bb2 gen2b.py): CD bum9b/bum9examples1/usercode/sphere.bb2
; load, SAVE over the file, QUIT; saved file and .bak = original
; @source K bum9b/bum9examples1/usercode/sphere.bb2
; @roundtrip
; @expect exists sphere.bb2.info
; @est 4
timeout 30
wait req "OKEE DOKEE"
gad 1
wait screen
dump start
menu 0 2
wait freq "Name to save file as"
freq ok
wait screen
dump saved
menu 0 9
wait exit
