; Stage 2b compile through the menu (generated once by bb2 gen2b.py): corpus t09_memacc
; CREATE EXECUTABLE without runtime errors; = the corpus ref run (tests/corpus)
; @source T t09_memacc
; @xtra norunerr
; @expect corpus t09_memacc t09_memacc
; @expect same t09_memacc.bb2
; @est 4
timeout 10
wait req "OKEE DOKEE"
gad 1
wait screen
menu 4 2
wait freq "Name of Executable to create"
timeout 30
freq ok "t09_memacc" "TEDRUN:work"
timeout 10
wait screen
menu 0 9
wait exit
