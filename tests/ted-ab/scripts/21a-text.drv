; Stage 2b text source (generated once by bb2 gen2b.py): CD internet/tritonblitz/tritonblitz/demos/memo.bb2
; plain text, tokenised by readline on load; SAVE writes the tokenised
; form = what the original TED saves (save/ hash of the TED oracle)
; @source K internet/tritonblitz/tritonblitz/demos/memo.bb2
; @expect tedsave memo.bb2 internet/tritonblitz/tritonblitz/demos/memo.bb2
; @expect bak memo.bb2.bak
; @est 3
timeout 10
wait req "OKEE DOKEE"
gad 1
wait screen
dump start
menu 0 2
wait freq "Name to save file as"
freq ok
wait screen
menu 0 9
wait exit
