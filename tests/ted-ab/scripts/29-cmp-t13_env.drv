; Stage 2b compile through the menu (generated once by bb2 gen2b.py): corpus t13_env
; CREATE EXECUTABLE without runtime errors; = the corpus ref run (tests/corpus)
; @source T t13_env
; @xtra norunerr
; @expect corpus t13_env t13_env
; @expect same t13_env.bb2
; @est 4
timeout 10
wait req "OKEE DOKEE"
gad 1
wait screen
menu 4 2
wait freq "Name of Executable to create"
timeout 30
freq ok "t13_env" "TEDRUN:work"
timeout 10
wait screen
menu 0 9
wait exit
