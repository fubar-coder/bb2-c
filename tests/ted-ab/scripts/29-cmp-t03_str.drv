; Stage 2b compile through the menu (generated once by bb2 gen2b.py): corpus t03_str
; CREATE EXECUTABLE without runtime errors; = the corpus ref run (tests/corpus)
; @source T t03_str
; @xtra norunerr
; @expect corpus t03_str t03_str
; @expect same t03_str.bb2
; @est 4
timeout 10
wait req "OKEE DOKEE"
gad 1
wait screen
menu 4 2
wait freq "Name of Executable to create"
timeout 30
freq ok "t03_str" "TEDRUN:work"
timeout 10
wait screen
menu 0 9
wait exit
