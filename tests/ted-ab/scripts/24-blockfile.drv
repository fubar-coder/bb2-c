; Stage 2b: BLOCK SAVE / BLOCK LOAD (file requesters with blokpath/blokname,
; both empty: full names).  Block lines 1-2, save, forget, 4 down, load.
; @source T t04_arr
; @expect exists blk.bb2
; @expect bak t04_arr.bb2.bak
; @expect exists t04_arr.bb2
; @est 8
timeout 10
wait req "OKEE DOKEE"
gad 1
wait screen
key 4d
key 50
key 4d
key 4d
key 51
menu 1 2
wait freq "Name to save block as"
freq ok "TEDRUN:work/blk.bb2"
wait screen
menu 1 4
key 4d
key 4d
key 4d
key 4d
menu 1 3
wait freq "Name of block to load"
freq ok "TEDRUN:work/blk.bb2"
wait screen
dump loaded
menu 0 2
wait freq "Name to save file as"
freq ok
wait screen
menu 0 9
wait exit
