; Stage 2b compile through the menu (generated once by bb2 gen2b.py): corpus t07_pre
; CREATE EXECUTABLE without runtime errors; = the corpus ref run (tests/corpus)
; @source T t07_pre
; @xtra norunerr
; @expect corpus t07_pre t07_pre
; @expect same t07_pre.bb2
; @est 4
timeout 10
wait req "OKEE DOKEE"
gad 1
wait screen
menu 4 2
wait freq "Name of Executable to create"
timeout 30
freq ok "t07_pre" "TEDRUN:work"
timeout 10
wait screen
menu 0 9
wait exit
