; Stage 2b compile through the menu (generated once by bb2 gen2b.py): corpus t12_util
; CREATE EXECUTABLE without runtime errors; = the corpus ref run (tests/corpus)
; @source T t12_util
; @xtra norunerr
; @expect corpus t12_util t12_util
; @expect same t12_util.bb2
; @est 4
timeout 10
wait req "OKEE DOKEE"
gad 1
wait screen
menu 4 2
wait freq "Name of Executable to create"
timeout 30
freq ok "t12_util" "TEDRUN:work"  ; @ignore compilewindow
timeout 10
wait screen
menu 0 9
wait exit
