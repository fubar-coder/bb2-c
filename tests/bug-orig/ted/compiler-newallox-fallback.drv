; @file bo.bas "!b:!b:!b:!b:!b\n!b:!b:!b:!b:!b\n!b:!b:!b:!b:!b\n!b:!b:!b:!b:!b\n!b:!b:!b:!b:!b\n"
; @source F bo.bas
; @command TEDAB:tools/inject alerts allocfail=86016-86016/f=10001/1 blitz2:blitz2 @FILE@
; @expect stdout "inject: allocfail: 1 allocations failed"
; @expect stdout "inject: alert: Not enough memory for operation!"
; @expect stdout "inject: rc=0"
timeout 20
wait req "OKEE DOKEE"
gad 1
wait screen
timeout 60
menu 4 0  ; @ignore compilewindow
wait req "INCREASE 150% - RECOMPILE"
gad 1
timeout 20
wait screen
timeout 60
menu 4 0  ; @ignore compilewindow
wait req "INCREASE 150% - RECOMPILE"
gad 3
timeout 20
wait screen
menu 0 9
wait exit
