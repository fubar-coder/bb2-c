; compiler-compare-fraction-const (#1186) - a comparison with a constant
; with a fraction gives the same boolean in every destination (Byte, Word,
; Long, Quick, Float): two such constants, one against a Quick or Float
; variable in both orders, negated, of each size, and whole-number
; constants of each size.  The fix of #1177 fetches the right operand of
; a comparison without a wanted type (a constant with a fraction is a
; Float there), but the left operand under a Byte destination went
; through the byte sizing of constants, which cuts the constant to a
; whole number: rb.b=(1.5=1.5) compared 1 with 1.5 (0), (1.5<1.5) was -1.
; The destinations are one case each (b Byte, w Word, l Long, q Quick, f Float); the
; check names are the number of the comparison of that destination (01 ... 30).

!TestCase{compare_into_byte}
  vq.q=1.5 : vf.f=2.5 : vb.b=1
  rb.b=0
  rb=(1.5=1.5)
  !CheckEq{rb,-1,"c01"}
  rb=(2.5=2.5)
  !CheckEq{rb,-1,"c02"}
  rb=(1.5<1.5)
  !CheckEq{rb,0,"c03"}
  rb=(1.5<1.9)
  !CheckEq{rb,-1,"c04"}
  rb=(1.9>1.5)
  !CheckEq{rb,-1,"c05"}
  rb=(1.5<>2.5)
  !CheckEq{rb,-1,"c06"}
  rb=(1.5>=1.5)
  !CheckEq{rb,-1,"c07"}
  rb=(1.5<=1.4)
  !CheckEq{rb,0,"c08"}
  rb=(vq=1.5)
  !CheckEq{rb,-1,"c09"}
  rb=(1.5=vq)
  !CheckEq{rb,-1,"c10"}
  rb=(1.5<vq)
  !CheckEq{rb,0,"c11"}
  rb=(vq<=1.5)
  !CheckEq{rb,-1,"c12"}
  rb=(1.6>vq)
  !CheckEq{rb,-1,"c13"}
  rb=(vf=2.5)
  !CheckEq{rb,-1,"c14"}
  rb=(2.5=vf)
  !CheckEq{rb,-1,"c15"}
  rb=(2.4<vf)
  !CheckEq{rb,-1,"c16"}
  rb=(vf>2.4)
  !CheckEq{rb,-1,"c17"}
  rb=(-1.5=-1.5)
  !CheckEq{rb,-1,"c18"}
  rb=(-1.5<-1.4)
  !CheckEq{rb,-1,"c19"}
  rb=(-(1.5)=-1.5)
  !CheckEq{rb,-1,"c20"}
  rb=(200.5=200.5)
  !CheckEq{rb,-1,"c21"}
  rb=(40000.5=40000.5)
  !CheckEq{rb,-1,"c22"}
  rb=(2.5e-1<0.3)
  !CheckEq{rb,-1,"c23"}
  rb=(1.5>vb)
  !CheckEq{rb,-1,"c24"}
  rb=(vb=1.5)
  !CheckEq{rb,0,"c25"}
  rb=(1.0=vb)
  !CheckEq{rb,-1,"c26"}
  rb=(3=3)
  !CheckEq{rb,-1,"c27"}
  rb=(200=200)
  !CheckEq{rb,-1,"c28"}
  rb=(100000=100000)
  !CheckEq{rb,-1,"c29"}
  rb=(vb<200)
  !CheckEq{rb,-1,"c30"}
!EndTestCase

