# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
print-add-b-cf-A 4
print-add-cb-cf-A 4
print-sub-b-cf-A 2
print-sub-cb-cf-A 2
print-mul-b-cf-A 3
print-mul-cb-cf-A 3
print-div-b-cf-A 3
print-div-cb-cf-A 3
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/compiler-expr-1188-print-A-01.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/compiler-expr-1188-print-A-01
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
