# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
error 16 Bad Data
[run]
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/compiler-quick-literal-data.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/compiler-quick-literal-data
openreq "***** COMPILING *****"
RESULT	j000	error	16	Bad Data	Data.q 32767.9999,-32767.9999,-32768.00001,32767.5
BATCH	end
