# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/compiler-loaddmod-pointer.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/compiler-loaddmod-pointer
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
ezfreq "Debug module to load" -> blitz2:dbgmod
MENU	j001	9	-1
POINTER	j001	busy
BATCH	end
