# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
i2-lsl-q-b-I 97
i2-lsl-q-w-I 97
i2-lsl-q-l-I 97
i2-lsl-q-q-I 97
i2-lsl-q-cb-I 97
i2-lsl-q-cw-I 97
i2-lsl-q-cl-I 97
i2-asl-q-b-I 97
i2-asl-q-w-I 97
i2-asl-q-l-I 97
i2-asl-q-q-I 97
i2-asl-q-cb-I 97
i2-asl-q-cw-I 97
i2-asl-q-cl-I 97
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/compiler-expr-1179-i2-I-u-01.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/compiler-expr-1179-i2-I-u-01
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
