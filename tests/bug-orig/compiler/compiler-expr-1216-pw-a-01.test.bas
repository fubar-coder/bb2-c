; compiler-expr-1216-pw-a-01 (#1216) - expression matrix: open cells,
; context pw, value set A, 13 cells
; BUG(orig) (#1216): an operand is typed by the type so far and its
; place in the chain, not by its own type and the wanted type.
; Correct: the values of the decided rule (EM_RULES_DECIDED, tools/lib/exprmatrix/
; model.c); the original's values are the declared deviations of the test.
; cells: pw-div-q-l-A pw-mod-b-f-A pw-mod-w-q-A pw-mod-w-cf-A
; cells: pw-mod-l-q-A pw-mod-l-cf-A pw-mod-f-q-A pw-mod-f-cf-A
; cells: pw-mod-cb-f-A pw-mod-cw-q-A pw-mod-cw-cf-A pw-mod-cl-q-A
; cells: pw-mod-cl-cf-A
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
DEFTYPE .w gw
Statement pw{x.w}
  SHARED gw
  gw=x
End Statement
!TestCase{cells}
  vb.b=3 : vw.w=1000 : vl.l=100000 : vq.q=1.5 : vf.f=2.5
  pw{vq / vl} : !CheckEq{gw,0,"pw-div-q-l-A"}
  pw{vb MOD vf} : !CheckEq{gw,0,"pw-mod-b-f-A"}
  pw{vw MOD vq} : !CheckEq{gw,1,"pw-mod-w-q-A"}
  pw{vw MOD 1.5} : !CheckEq{gw,1,"pw-mod-w-cf-A"}
  pw{vl MOD vq} : !CheckEq{gw,1,"pw-mod-l-q-A"}
  pw{vl MOD 1.5} : !CheckEq{gw,1,"pw-mod-l-cf-A"}
  pw{vf MOD vq} : !CheckEq{gw,1,"pw-mod-f-q-A"}
  pw{vf MOD 1.5} : !CheckEq{gw,1,"pw-mod-f-cf-A"}
  pw{3 MOD vf} : !CheckEq{gw,0,"pw-mod-cb-f-A"}
  pw{1000 MOD vq} : !CheckEq{gw,1,"pw-mod-cw-q-A"}
  pw{1000 MOD 1.5} : !CheckEq{gw,1,"pw-mod-cw-cf-A"}
  pw{100000 MOD vq} : !CheckEq{gw,1,"pw-mod-cl-q-A"}
  pw{100000 MOD 1.5} : !CheckEq{gw,1,"pw-mod-cl-cf-A"}
!EndTestCase
