# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
error 12 Can't open Include
[run]
[blitz2]
inject: rc=0
inject: in use: CORPUS:bindir
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/compiler-incbin-leaks.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/compiler-incbin-leaks
openreq "***** COMPILING *****"
RESULT	j000	error	12	Can't open Include	IncBin "CORPUS:bindir"
BATCH	end
