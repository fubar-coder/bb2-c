  pl{vl MOD vq} : !CheckEq{gl,1,"pl-mod-l-q-A"}
  pl{vl MOD 1.5} : !CheckEq{gl,1,"pl-mod-l-cf-A"}
  pl{vf MOD vq} : !CheckEq{gl,1,"pl-mod-f-q-A"}
  pl{vf MOD 1.5} : !CheckEq{gl,1,"pl-mod-f-cf-A"}
  pl{3 MOD vf} : !CheckEq{gl,0,"pl-mod-cb-f-A"}
  pl{1000 MOD vq} : !CheckEq{gl,1,"pl-mod-cw-q-A"}
  pl{1000 MOD 1.5} : !CheckEq{gl,1,"pl-mod-cw-cf-A"}
  pl{100000 MOD vq} : !CheckEq{gl,1,"pl-mod-cl-q-A"}
  pl{100000 MOD 1.5} : !CheckEq{gl,1,"pl-mod-cl-cf-A"}
!EndTestCase
