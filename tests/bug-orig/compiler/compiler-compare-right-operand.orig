# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
01 rl.l=lw+(l1=l1) 0
02 rl.l=lw-(l1=l1) 2
03 rl.l=lw*(l1=l1) -1
04 rl.l=lw AND (l1=l1) 1
05 rl.l=lw AND l1=l1 1
06 rl.l=lw OR (l1<>l1) 1
07 rl.l=(l1=l1) AND lw 65537
08 rl.l=lw+l1=l1 0
09 If lw AND (l1=l1) -1
10 If $10000 AND (l1=l1) 0
11 lw=$10000 : If lw AND l1=l1 0
12 rl.l=lb+(l1=l1) -31073
13 rf.f=f25+(l1=l1) 1
14 rf.f=f25-(l1=l1) 3
15 rf.f=f25*(l1=l1) -2
16 rf.f=fbig+(l1=l1) -31073
17 rf.f=fh+((l1=l1)) -1
18 rf.f=fh+(l1=l1)+fz -1
19 rf.f=fz+fh+(l1=l1) -1
20 rf.f=fh+(l1=l1)*1 -1
21 rf.f=fh+(0+(l1=l1)) -1
22 rq.q=q+(l1=l1) 0
23 rq.q=q*(l1=l1) -1
24 rq.q=(l1=l1)+q .5
25 If q+(l1=l1)>0 0
26 If f25*(l1=l1) < -2.25 0
27 rf.f=w+(l1=l1) 2
28 rl.l=lb+(w=w) -31073
29 rl.l=lb+(q=q) -31073
30 rl.l=lb+(fh=fh) -31073
31 rl.l=lw AND NOT(l1<>l1) 1
32 rl.l=lb+-(l1=l1) -31071
33 If qh OR (l1<>l1) 0
34 If qh EOR (l1<>l1) 0
35 flag=1 : If flag AND x=5 -1
36 flag=1.5 : If flag AND x=5 -1
37 flag=0.5 : If flag AND x=5 0
38 rl.l=q+(l1=l1) 0
39 rl.l=q*(l1=l1) -1
40 rw.w=b+(l1=l1) 2
41 rw.w=w AND (l1=l1) 3
42 rf.f=fh+tf{l1=l1} -.5
43 rf.f=fh+(l1=l1)*100000 -100000
44 rq.q=qh OR (l1<>l1) 0
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/compiler-compare-right-operand.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/compiler-compare-right-operand
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
