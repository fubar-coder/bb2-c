  pl{-3 MOD vq} : !CheckEq{gl,0,"pl-mod-cb-q-B"}
  pl{-1000 MOD vq} : !CheckEq{gl,-3,"pl-mod-cw-q-B"}
  pl{-100000 MOD vq} : !CheckEq{gl,-3,"pl-mod-cl-q-B"}
