# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
01 rb.b=(1.5+1.5) 2
02 rw.w=(1.5+1.5) 3
03 rb.b=(0.5*4) 0
04 rw.w=(0.5*4) 2
05 rb.b=(1.5*vb) 2
06 rw.w=(1.5*vb) 3
07 rb.b=(2.5*2) 4
08 rw.w=(2.5*2) 5
09 rb.b=(-1.5*vb) -2
10 rw.w=(-1.5*vb) -3
11 rb.b=(1.25e1*2) 24
12 rw.w=(1.25e1*2) 25
13 sb{1.5*vb}
sb 2
14 fb{1.5*vb} 2
15 nv\f=(1.5+1.5) 2
16 ab(1)=(1.5*vb) 2
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/compiler-byte-fraction-const.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/compiler-byte-fraction-const
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
