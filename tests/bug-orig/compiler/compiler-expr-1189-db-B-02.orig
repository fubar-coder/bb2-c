# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
db-pow-cl-b-B -1
db-pow-cl-w-B -1
db-pow-cl-l-B -1
db-pow-cl-q-B -1
db-pow-cl-f-B -1
db-pow-cl-cb-B -1
db-pow-cl-cw-B -1
db-pow-cl-cl-B -1
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/compiler-expr-1189-db-B-02.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/compiler-expr-1189-db-B-02
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
