# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
dl-pow-q-b-B 8
dl-pow-q-w-B 8
dl-pow-q-l-B 8
dl-pow-q-q-B 8
dl-pow-q-f-B 8
dl-pow-q-cb-B 8
dl-pow-q-cw-B 8
dl-pow-q-cl-B 8
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/compiler-expr-1178-1189-dl-B-01.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/compiler-expr-1178-1189-dl-B-01
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
