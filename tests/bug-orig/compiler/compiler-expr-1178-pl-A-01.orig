# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
pl-neg-q-A -1
pl-add-q-q-A 2
pl-add-q-f-A 3
pl-add-q-cf-A 2
pl-sub-b-q-A 2
pl-sub-w-q-A 999
pl-sub-l-q-A 99999
pl-sub-cb-q-A 2
pl-sub-cw-q-A 999
pl-sub-cl-q-A 99999
pl-mul-b-q-A 3
pl-mul-w-q-A 1000
pl-mul-l-q-A 100000
pl-mul-q-b-A 3
pl-mul-q-w-A 1000
pl-mul-q-l-A 100000
pl-mul-q-q-A 1
pl-mul-q-f-A 2
pl-mul-q-cb-A 3
pl-mul-q-cw-A 1000
pl-mul-q-cl-A 100000
pl-mul-q-cf-A 1
pl-mul-cb-q-A 3
pl-mul-cw-q-A 1000
pl-mul-cl-q-A 100000
pl-div-b-q-A 3
pl-div-w-q-A 1000
pl-div-l-q-A 100000
pl-div-q-cf-A 0
pl-div-cb-q-A 3
pl-div-cw-q-A 1000
pl-div-cl-q-A 100000
pl-pow-q-b-A 1
pl-pow-q-w-A 1
pl-pow-q-l-A 1
pl-pow-q-q-A 1
pl-pow-q-f-A 1
pl-pow-q-cb-A 1
pl-pow-q-cw-A 1
pl-pow-q-cl-A 1
pl-pow-q-cf-A 1
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/compiler-expr-1178-pl-A-01.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/compiler-expr-1178-pl-A-01
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
