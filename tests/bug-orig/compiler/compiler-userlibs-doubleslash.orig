# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
error 8 Token Not Found : $0501.
[run]
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/compiler-userlibs-doubleslash.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/compiler-userlibs-doubleslash
openreq "***** COMPILING *****"
RESULT	j000	error	8	Token Not Found : $0501.	NPrint {$8501}
BATCH	end
