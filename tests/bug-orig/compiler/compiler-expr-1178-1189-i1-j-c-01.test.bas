; compiler-expr-1178-1189-i1-j-c-01 (#1178 and #1189) - expression
; matrix: open cells, context i1, value set J, runtime error checking
; on, 8 cells
; BUG(orig) (#1178): a Quick fetched while the type so far is Long is
; cut to a whole number at once.
; BUG(orig) (#1189): ^ with a negative base drops the sign of the power.
; Correct: the values of the fixed rules of the matrix's model (tools/lib/exprmatrix/
; model.c); the original's values are the declared deviations of the test.
; The cells need the fixes of both issues: after the first fix the port
; neither reproduces the original nor meets the expectation and the test fails;
; the commit of the second fix marks it fixed.
; cells: i1-pow-q-b-J i1-pow-q-w-J i1-pow-q-l-J i1-pow-q-q-J
; cells: i1-pow-q-f-J i1-pow-q-cb-J i1-pow-q-cw-J i1-pow-q-cl-J
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
!TestCase{cells}
  vq.q=-1.5
  nb.b=3 : nw.w=3 : nl.l=3 : nq.q=3 : nf.f=3
  Dim ia.l(300)
  For ii.l=0 To 300 : ia(ii)=ii*16+1 : Next
  vv.l=0
  vv=0 : SetErr : vv=-1 : Goto mx1 : End SetErr
  vv=ia(vq ^ nb)
  mx1:
  !CheckEq{vv,-1,"i1-pow-q-b-J"}
  vv=0 : SetErr : vv=-1 : Goto mx2 : End SetErr
  vv=ia(vq ^ nw)
  mx2:
  !CheckEq{vv,-1,"i1-pow-q-w-J"}
  vv=0 : SetErr : vv=-1 : Goto mx3 : End SetErr
  vv=ia(vq ^ nl)
  mx3:
  !CheckEq{vv,-1,"i1-pow-q-l-J"}
  vv=0 : SetErr : vv=-1 : Goto mx4 : End SetErr
  vv=ia(vq ^ nq)
  mx4:
  !CheckEq{vv,-1,"i1-pow-q-q-J"}
  vv=0 : SetErr : vv=-1 : Goto mx5 : End SetErr
  vv=ia(vq ^ nf)
  mx5:
  !CheckEq{vv,-1,"i1-pow-q-f-J"}
  vv=0 : SetErr : vv=-1 : Goto mx6 : End SetErr
  vv=ia(vq ^ 3)
  mx6:
  !CheckEq{vv,-1,"i1-pow-q-cb-J"}
  vv=0 : SetErr : vv=-1 : Goto mx7 : End SetErr
  vv=ia(vq ^ 3)
  mx7:
  !CheckEq{vv,-1,"i1-pow-q-cw-J"}
  vv=0 : SetErr : vv=-1 : Goto mx8 : End SetErr
  vv=ia(vq ^ 3)
  mx8:
  !CheckEq{vv,-1,"i1-pow-q-cl-J"}
  ClrErr
!EndTestCase
