# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
pl-neg-q-B 2
pl-add-q-q-B -4
pl-sub-b-q-B -1
pl-sub-w-q-B -998
pl-sub-l-q-B -99998
pl-sub-q-f-B 0
pl-sub-cb-q-B -1
pl-sub-cw-q-B -998
pl-sub-cl-q-B -99998
pl-mul-b-q-B 6
pl-mul-w-q-B 2000
pl-mul-l-q-B 200000
pl-mul-q-b-B 6
pl-mul-q-w-B 2000
pl-mul-q-l-B 200000
pl-mul-q-q-B 4
pl-mul-q-f-B 5
pl-mul-q-cb-B 6
pl-mul-q-cw-B 2000
pl-mul-q-cl-B 200000
pl-mul-q-cf-B 3
pl-mul-cb-q-B 6
pl-mul-cw-q-B 2000
pl-mul-cl-q-B 200000
pl-div-b-q-B 1
pl-div-w-q-B 500
pl-div-l-q-B 50000
pl-div-cb-q-B 1
pl-div-cw-q-B 500
pl-div-cl-q-B 50000
pl-mod-q-f-B 0
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/compiler-expr-1178-pl-B-01.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/compiler-expr-1178-pl-B-01
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
