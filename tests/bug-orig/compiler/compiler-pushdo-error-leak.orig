# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
error 13 Can't Convert Types
[run]
[blitz2]
inject: rc=0
inject: track: 1 allocations left, 18 bytes
inject:   18 bytes, flags $1
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/compiler-pushdo-error-leak.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/compiler-pushdo-error-leak
openreq "***** COMPILING *****"
RESULT	j000	error	13	Can't Convert Types	a(i)=1+"x"
BATCH	end
