; do not edit
DEFTYPE .q gq
Statement pq{x.q}
  SHARED gq
  gq=x
End Statement
!TestCase{cells}
  vb.b=-3 : vw.w=-1000 : vl.l=-100000 : vq.q=-1.5 : vf.f=-2.5
  pq{vq + -100000} : !CheckEq{Peek.l(&gq),$795E8000,"pq-add-q-cl-B"}
  pq{-100000 + vq} : !CheckEq{Peek.l(&gq),$795E8000,"pq-add-cl-q-B"}
  pq{vq - -100000} : !CheckEq{Peek.l(&gq),$869E8000,"pq-sub-q-cl-B"}
  pq{vl / vq} : !CheckEq{Peek.l(&gq),$046AAAAA,"pq-div-l-q-B"}
  pq{vl / vf} : !CheckEq{Peek.l(&gq),$9C400000,"pq-div-l-f-B"}
  pq{vl / -100000} : !CheckEq{Peek.l(&gq),$00010000,"pq-div-l-cl-B"}
  pq{vq / vl} : !CheckEq{Peek.l(&gq),$00000000,"pq-div-q-l-B"}
  pq{vb MOD vq} : !CheckEq{Peek.l(&gq),$00000000,"pq-mod-b-q-B"}
  pq{vw MOD vq} : !CheckEq{Peek.l(&gq),$FFFD8000,"pq-mod-w-q-B"}
  pq{vl MOD vq} : !CheckEq{Peek.l(&gq),$FFFD8000,"pq-mod-l-q-B"}
  pq{vl MOD -100000} : !CheckEq{Peek.l(&gq),$00000000,"pq-mod-l-cl-B"}
  pq{vq MOD vb} : !CheckEq{Peek.l(&gq),$FFFB8000,"pq-mod-q-b-B"}
  pq{vq MOD vw} : !CheckEq{Peek.l(&gq),$FC168000,"pq-mod-q-w-B"}
  pq{vq MOD vl} : !CheckEq{Peek.l(&gq),$795E8000,"pq-mod-q-l-B"}
  pq{vq MOD -3} : !CheckEq{Peek.l(&gq),$FFFB8000,"pq-mod-q-cb-B"}
  pq{vq MOD -1000} : !CheckEq{Peek.l(&gq),$FC168000,"pq-mod-q-cw-B"}
  pq{vq MOD -100000} : !CheckEq{Peek.l(&gq),$795E8000,"pq-mod-q-cl-B"}
  pq{-3 MOD vq} : !CheckEq{Peek.l(&gq),$00000000,"pq-mod-cb-q-B"}
  pq{-1000 MOD vq} : !CheckEq{Peek.l(&gq),$FFFD8000,"pq-mod-cw-q-B"}
  pq{-100000 MOD vq} : !CheckEq{Peek.l(&gq),$FFFD8000,"pq-mod-cl-q-B"}
!EndTestCase
