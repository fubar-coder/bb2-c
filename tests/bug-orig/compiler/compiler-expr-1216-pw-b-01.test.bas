; compiler-expr-1216-pw-b-01 (#1216) - expression matrix: open cells,
; context pw, value set B, 13 cells
; BUG(orig) (#1216): an operand is typed by the type so far and its
; place in the chain, not by its own type and the wanted type.
; Correct: the values of the decided rule (EM_RULES_DECIDED, tools/lib/exprmatrix/
; model.c); the values of the port and the original, which agree, are the declared
; deviations of the test.
; cells: pw-div-q-l-B pw-mod-b-q-B pw-mod-w-q-B pw-mod-w-cf-B
; cells: pw-mod-l-q-B pw-mod-l-cf-B pw-mod-q-f-B pw-mod-f-q-B
; cells: pw-mod-f-cf-B pw-mod-cb-q-B pw-mod-cw-q-B pw-mod-cl-q-B
; cells: pw-mod-cf-f-B
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
DEFTYPE .w gw
Statement pw{x.w}
  SHARED gw
  gw=x
End Statement
!TestCase{cells}
  vb.b=-3 : vw.w=-1000 : vl.l=-100000 : vq.q=-1.5 : vf.f=-2.5
  pw{vq / vl} : !CheckEq{gw,0,"pw-div-q-l-B"}
  pw{vb MOD vq} : !CheckEq{gw,0,"pw-mod-b-q-B"}
  pw{vw MOD vq} : !CheckEq{gw,-3,"pw-mod-w-q-B"}
  pw{vw MOD -1.5} : !CheckEq{gw,-2,"pw-mod-w-cf-B"}
  pw{vl MOD vq} : !CheckEq{gw,-3,"pw-mod-l-q-B"}
  pw{vl MOD -1.5} : !CheckEq{gw,-2,"pw-mod-l-cf-B"}
  pw{vq MOD vf} : !CheckEq{gw,-4,"pw-mod-q-f-B"}
  pw{vf MOD vq} : !CheckEq{gw,-2,"pw-mod-f-q-B"}
  pw{vf MOD -1.5} : !CheckEq{gw,-2,"pw-mod-f-cf-B"}
  pw{-3 MOD vq} : !CheckEq{gw,0,"pw-mod-cb-q-B"}
  pw{-1000 MOD vq} : !CheckEq{gw,-3,"pw-mod-cw-q-B"}
  pw{-100000 MOD vq} : !CheckEq{gw,-3,"pw-mod-cl-q-B"}
  pw{-1.5 MOD vf} : !CheckEq{gw,-4,"pw-mod-cf-f-B"}
!EndTestCase
