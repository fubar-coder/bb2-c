# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
db-add-cf-q-A 2
db-add-cf-f-A 3
db-add-cf-cf-A 2
db-sub-b-cf-A 2
db-sub-cb-cf-A 2
db-sub-cf-b-A -2
db-sub-cf-w-A 25
db-sub-cf-l-A 97
db-sub-cf-q-A -1
db-sub-cf-cb-A -2
db-sub-cf-cw-A 25
db-sub-cf-cl-A 97
db-mul-b-cf-A 3
db-mul-cb-cf-A 3
db-mul-cf-b-A 3
db-mul-cf-w-A -24
db-mul-cf-l-A -96
db-mul-cf-q-A 1
db-mul-cf-f-A 2
db-mul-cf-cb-A 3
db-mul-cf-cw-A -24
db-mul-cf-cl-A -96
db-mul-cf-cf-A 1
db-div-b-cf-A 3
db-div-cb-cf-A 3
db-div-cf-q-A 0
db-pow-b-cf-A 9
db-pow-cb-cf-A 9
db-pow-cf-b-A 1
db-pow-cf-w-A 1
db-pow-cf-l-A 1
db-pow-cf-q-A 1
db-pow-cf-f-A 1
db-pow-cf-cb-A 1
db-pow-cf-cw-A 1
db-pow-cf-cl-A 1
db-pow-cf-cf-A 1
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/compiler-expr-1188-db-A-01.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/compiler-expr-1188-db-A-01
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
