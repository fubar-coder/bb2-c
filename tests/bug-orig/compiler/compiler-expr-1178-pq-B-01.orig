# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
pq-sub-cl-q-B 79620000
pq-mul-q-cl-B 0D400000
pq-mul-cl-q-B 0D400000
pq-mul-cf-cl-B 0D400000
pq-div-cl-q-B C3500000
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/compiler-expr-1178-pq-B-01.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/compiler-expr-1178-pq-B-01
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
