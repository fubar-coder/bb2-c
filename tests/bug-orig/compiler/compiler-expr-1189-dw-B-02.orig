# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
dw-pow-cl-b-B -1
dw-pow-cl-w-B -1
dw-pow-cl-l-B -1
dw-pow-cl-q-B -1
dw-pow-cl-f-B -1
dw-pow-cl-cb-B -1
dw-pow-cl-cw-B -1
dw-pow-cl-cl-B -1
dw-pow-cf-b-B 3
dw-pow-cf-w-B 3
dw-pow-cf-l-B 3
dw-pow-cf-q-B 3
dw-pow-cf-f-B 3
dw-pow-cf-cb-B 3
dw-pow-cf-cw-B 3
dw-pow-cf-cl-B 3
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/compiler-expr-1189-dw-B-02.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/compiler-expr-1189-dw-B-02
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
