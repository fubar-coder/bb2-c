# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
error 17 If Without End If
[run]
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/compiler-macro-end-line.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/compiler-macro-end-line
openreq "***** COMPILING *****"
RESULT	j000	error	17	If Without End If	!m{0}
BATCH	end
