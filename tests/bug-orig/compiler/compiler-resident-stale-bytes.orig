# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
types 2 macros 1 constants 1 text 3
pad: field 1 type 1 macro 1 text 1 constant 1
constant: data 1 procnum 1
field type low word 1 type next 1
rc=0
[blitz2]
inject: rc=0
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	r	CORPUS:r.bb2
XTRA	r	none
ezfreq "Name of Executable to create" -> CORPUS:out/r.res
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	r	ok
ezfreq "Name of Resident File to Create" -> CORPUS:out/r.res
MENU	r	4	-1
POINTER	r	normal
JOB	j000	CORPUS:src/compiler-resident-stale-bytes.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/compiler-resident-stale-bytes
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
