# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
error 13 Constant Not Found
[run]
[blitz2]
inject: rc=0
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	r	CORPUS:r.bb2
XTRA	r	none
ezfreq "Name of Executable to create" -> CORPUS:out/r.res
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	r	ok
ezfreq "Name of Resident File to Create" -> CORPUS:out/r.res
MENU	r	4	-1
POINTER	r	normal
JOB	j000	CORPUS:src/compiler-fixtypes-nofields.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/compiler-fixtypes-nofields
openreq "***** COMPILING *****"
RESULT	j000	error	13	Constant Not Found	NPrint #c
BATCH	end
