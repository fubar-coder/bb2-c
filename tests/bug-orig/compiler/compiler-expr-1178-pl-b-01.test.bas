DEFTYPE .l gl
Statement pl{x.l}
  SHARED gl
  gl=x
End Statement
!TestCase{cells}
  vb.b=-3 : vw.w=-1000 : vl.l=-100000 : vq.q=-1.5 : vf.f=-2.5
  pl{-vq} : !CheckEq{gl,1,"pl-neg-q-B"}
  pl{vq + vq} : !CheckEq{gl,-3,"pl-add-q-q-B"}
  pl{vb - vq} : !CheckEq{gl,-2,"pl-sub-b-q-B"}
  pl{vw - vq} : !CheckEq{gl,-999,"pl-sub-w-q-B"}
  pl{vl - vq} : !CheckEq{gl,-99999,"pl-sub-l-q-B"}
  pl{vq - vf} : !CheckEq{gl,1,"pl-sub-q-f-B"}
  pl{-3 - vq} : !CheckEq{gl,-2,"pl-sub-cb-q-B"}
  pl{-1000 - vq} : !CheckEq{gl,-999,"pl-sub-cw-q-B"}
  pl{-100000 - vq} : !CheckEq{gl,-99999,"pl-sub-cl-q-B"}
  pl{vb * vq} : !CheckEq{gl,4,"pl-mul-b-q-B"}
  pl{vw * vq} : !CheckEq{gl,1500,"pl-mul-w-q-B"}
  pl{vl * vq} : !CheckEq{gl,150000,"pl-mul-l-q-B"}
  pl{vq * vb} : !CheckEq{gl,4,"pl-mul-q-b-B"}
  pl{vq * vw} : !CheckEq{gl,1500,"pl-mul-q-w-B"}
  pl{vq * vl} : !CheckEq{gl,150000,"pl-mul-q-l-B"}
  pl{vq * vq} : !CheckEq{gl,2,"pl-mul-q-q-B"}
  pl{vq * vf} : !CheckEq{gl,3,"pl-mul-q-f-B"}
  pl{vq * -3} : !CheckEq{gl,4,"pl-mul-q-cb-B"}
  pl{vq * -1000} : !CheckEq{gl,1500,"pl-mul-q-cw-B"}
  pl{vq * -100000} : !CheckEq{gl,150000,"pl-mul-q-cl-B"}
  pl{vq * -1.5} : !CheckEq{gl,2,"pl-mul-q-cf-B"}
  pl{-3 * vq} : !CheckEq{gl,4,"pl-mul-cb-q-B"}
  pl{-1000 * vq} : !CheckEq{gl,1500,"pl-mul-cw-q-B"}
  pl{-100000 * vq} : !CheckEq{gl,150000,"pl-mul-cl-q-B"}
  pl{vb / vq} : !CheckEq{gl,2,"pl-div-b-q-B"}
  pl{vw / vq} : !CheckEq{gl,666,"pl-div-w-q-B"}
  pl{vl / vq} : !CheckEq{gl,66666,"pl-div-l-q-B"}
  pl{-3 / vq} : !CheckEq{gl,2,"pl-div-cb-q-B"}
  pl{-1000 / vq} : !CheckEq{gl,666,"pl-div-cw-q-B"}
  pl{-100000 / vq} : !CheckEq{gl,66666,"pl-div-cl-q-B"}
  pl{vq MOD vf} : !CheckEq{gl,-3,"pl-mod-q-f-B"}
  pl{vq ^ 3.5} : !CheckEq{gl,4,"pl-pow-q-cf-B"}
!EndTestCase
