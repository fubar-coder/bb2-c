# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
done
[compile]
ok
[run]
before
# varies: the title is freed as an item, its "shortcut" and "sub items" read behind the 12-byte node; what lies there (the memory layout) decides whether memlib reports "Unable to Free Memory" or the program goes on
*
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/rigtmenulib-freemenu-negative-item.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/rigtmenulib-freemenu-negative-item
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
