# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
done
[compile]
ok
[run]
open -1
no toc 1 0 0 840
open scsi -1
scsi toc 2 0 0
lengths 840 14050
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/ricompactdisclib-toc-without-readtoc.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/ricompactdisclib-toc-without-readtoc
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
