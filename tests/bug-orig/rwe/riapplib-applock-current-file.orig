[session]
done
[compile]
ok
[run]
AppEvent: lock 1
Ram Disk:f1: lock 1
Ram Disk:bo1103a/f2: lock 1
AppFile(1) Ram Disk:f1: lock 1
Ram Disk:bo1103b/f3: lock 1
none left (): lock 1
AppFile(9) (): lock 1
AppFile(1) Ram Disk:f1: lock 1
next AppEvent: lock 1
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
