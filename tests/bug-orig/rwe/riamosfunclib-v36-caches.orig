# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
timeout
[compile]
ok
[run]
before
REQUESTER: AutoRequest body "Software error - task held" " Finish ALL disk activity" "Select CANCEL to reset/debug" pos "Retry" neg "Cancel" -> answered FALSE
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/riamosfunclib-v36-caches.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/riamosfunclib-v36-caches
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
