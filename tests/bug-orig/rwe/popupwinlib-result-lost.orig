# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
done
[compile]
error 63 Syntax Error
[run]
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/popupwinlib-result-lost.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/popupwinlib-result-lost
openreq "***** COMPILING *****"
RESULT	j000	error	63	Syntax Error	r=PopUpWindow(0,it)
BATCH	end
