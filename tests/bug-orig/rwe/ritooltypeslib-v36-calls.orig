# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
timeout
[compile]
ok
[run]
before
# varies: GetDiskObjectNew runs the memory before icon.library V34, which depends on the memory layout: the crash shows the Software Failure requester or hangs without one
...
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/ritooltypeslib-v36-calls.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/ritooltypeslib-v36-calls
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
