# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
done
[compile]
ok
[run]
list made
inject: openlibfail: 1 opens failed
inject: rc=0
inject: track: 1 allocations left, 502 bytes
inject:   502 bytes, flags $2
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/ridisplaylib-finit-without-graphics.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/ridisplaylib-finit-without-graphics
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
