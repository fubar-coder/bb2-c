[session]
done
[compile]
ok
[run]
sent 40
inject: rc=0
inject: track: 81 allocations left, 1171 bytes
# varies: the leftover allocations are listed in the order of their addresses (the first 64 only)
...
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
