# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
# varies: it returns to the long above its return address; whether the program comes to an end from there depends on what it finds
*
[compile]
ok
[run]
# varies: it returns to the long above its return address; the return code is what the program finds there
CORPUS:out/riseriallib-receiveblock-stop failed returncode *
# varies: what follows the return to the wrong address
...
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/riseriallib-receiveblock-stop.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/riseriallib-receiveblock-stop
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
