# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
# varies: the crash ends the session as a timeout or a halt of the CPU, depending on the memory layout (#428)
*
[compile]
ok
[run]
before
# varies: whether the second line is printed before the crash depends on the memory layout (#428)
...
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/bb_blitlib-createshape-count0.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/bb_blitlib-createshape-count0
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
