# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
halt
[compile]
ok
[run]
set
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/riarexxlib-defaultport-no-limit.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/riarexxlib-defaultport-no-limit
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
