# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
done
[compile]
ok
[run]
12x 192 0
%2 2 0
$g 16 0
1.5 2645 0
$ff 255 0
%101 5 0
-12 -12 0
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/rievallib-digits-unchecked.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/rievallib-digits-unchecked
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
