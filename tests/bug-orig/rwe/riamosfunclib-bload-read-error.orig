# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
done
[compile]
ok
[run]
-1
inject: readfail: 1 reads failed
inject: rc=0
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/riamosfunclib-bload-read-error.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/riamosfunclib-bload-read-error
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
