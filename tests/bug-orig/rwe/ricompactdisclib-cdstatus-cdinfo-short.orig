# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
timeout
[compile]
ok
[run]
open -1
status 7
open scsi -1
tracks scsi 2
played
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/ricompactdisclib-cdstatus-cdinfo-short.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/ricompactdisclib-cdstatus-cdinfo-short
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
