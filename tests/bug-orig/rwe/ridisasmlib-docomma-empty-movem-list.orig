# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
done
[compile]
ok
[run]
[movem.l  ,-(a7)                   ]
[movem.l  d0-d1,-(a7)              ]
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/ridisasmlib-docomma-empty-movem-list.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/ridisasmlib-docomma-empty-movem-list
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
