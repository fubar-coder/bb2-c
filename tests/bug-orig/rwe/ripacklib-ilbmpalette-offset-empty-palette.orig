# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
done
[compile]
ok
[run]
result -1
inject: rc=0
inject: guard: written behind an allocation of 72 bytes
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/ripacklib-ilbmpalette-offset-empty-palette.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/ripacklib-ilbmpalette-offset-empty-palette
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
