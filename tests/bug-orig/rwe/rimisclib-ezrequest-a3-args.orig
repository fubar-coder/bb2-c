# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
done
[compile]
ok
[run]
REQUESTER: EasyRequest title "T" text "B" gadgets "OK" -> answered 0
5 abT.B
REQUESTER: EasyRequest title "" text "B" gadgets "OK" -> answered 0
5 abB.O
REQUESTER: EasyRequest title "" text "B" gadgets "Ok" -> answered 0
5 abB.B
REQUESTER: EasyRequest title "T" text "B %ld" gadgets "OK" -> answered 0
5 abT.B
REQUESTER: EasyRequest title "" text "%d" gadgets "Ok" -> answered 0
5 ab.bT
REQUESTER: EasyRequest title "" text "%s
%s" gadgets "Ok" -> answered 0
5 abx.y
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/rimisclib-ezrequest-a3-args.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/rimisclib-ezrequest-a3-args
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
