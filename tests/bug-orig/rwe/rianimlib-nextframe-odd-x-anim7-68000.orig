# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
timeout
[compile]
ok
[run]
init -1
frame 2: -1 row 0 byte 1 000000AA
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/rianimlib-nextframe-odd-x-anim7-68000.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/rianimlib-nextframe-odd-x-anim7-68000
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
