# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
done
[compile]
ok
[run]
FormatTrack 1,1,buf: 252
FormatTrack 1,2,buf,11: 0
FormatTrack 1,3,buf,22: 0
WriteBoot 1,buf: 252
sector 0: 0 SECTOR 0000
sector 11: 0 SECTOR 0011
sector 21: 0 
sector 22: 0 A
sector 32: 0 K
sector 33: 0 A
sector 54: 0 V
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/ritrackdisklib-disk-formattrack.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/ritrackdisklib-disk-formattrack
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
