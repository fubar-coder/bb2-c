# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
done
[compile]
ok
[run]
row 0: FFFF0000
row 1: 00000000
row 2: 0000FFFF
row 3: FFFFFFFF
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/rifxlib-clearbitmap-last-word.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/rifxlib-clearbitmap-last-word
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
