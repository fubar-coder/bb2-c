JOB	j000	CORPUS:src/rifnslib-clip-ymax-inclusive.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/rifnslib-clip-ymax-inclusive
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
