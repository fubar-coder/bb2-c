# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
# varies: the original CreateMenuStrip builds a strip from address 0 (#689, port description libs/userlibs/rwe/rigtmenulib.c:368, :420, docs/libs/deviations.md:580); whether End then returns, halts the CPU or hangs depends on memory that differs between boots and snapshots
*
[compile]
ok
[run]
before
-1
-1
-1
a strip
a menu
# varies: the rest of the run depends on the same memory (#689): the original returns (rc=0) or halts or hangs after the output
...
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/rigtmenulib-createmenustrip-unchecked.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/rigtmenulib-createmenustrip-unchecked
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
