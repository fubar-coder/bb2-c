# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
done
[compile]
ok
[run]
open scsi -1
tracks scsi 2
open -1
tracks 2
open default -1
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/ricompactdisclib-opencd-scsiflag-kept.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/ricompactdisclib-opencd-scsiflag-kept
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
