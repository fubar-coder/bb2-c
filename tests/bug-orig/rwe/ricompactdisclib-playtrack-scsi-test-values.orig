# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
done
[compile]
ok
[run]
open scsi -1
before toc 0
track 1 0
track 2 0
track 3 0
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/ricompactdisclib-playtrack-scsi-test-values.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/ricompactdisclib-playtrack-scsi-test-values
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
