# the CD's blitz2 2.10 with the CD's libraries and the reference RWE library
[session]
done
[compile]
ok
[run]
c1.pack410 to dest: 1 equal -1 below kept -1 above kept -1
c1.pack410 in place: -1 equal -1
c1.pack410 STCLoad: -1 equal -1
c1.pack410_0 to dest: 1 equal -1 below kept -1 above kept -1
c1.pack410_0 in place: -1 equal -1
c1.pack410_0 STCLoad: -1 equal -1
efficiency 17: 1 below kept -1
odd packed length: 1 below kept -1
unpacked length +100: below kept 0
unpacked length -100: below kept 0
a bit flipped near the end: below kept 0
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/ristcdecrunchlib-optidec-real-data.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/ristcdecrunchlib-optidec-real-data
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
