  vv=ia(-200 MOD -1.5) : !CheckEq{vv,1,"i1-mod-cw-cf-J"}
  vv=ia(-40000 MOD vw) : !CheckEq{vv,1,"i1-mod-cl-w-J"}
  vv=ia(-40000 MOD vq) : !CheckEq{vv,1,"i1-mod-cl-q-J"}
  vv=ia(-40000 MOD vf) : !CheckEq{vv,1,"i1-mod-cl-f-J"}
  vv=ia(-40000 MOD -200) : !CheckEq{vv,1,"i1-mod-cl-cw-J"}
  vv=ia(-40000 MOD -40000) : !CheckEq{vv,1,"i1-mod-cl-cl-J"}
  vv=ia(-40000 MOD -1.5) : !CheckEq{vv,1,"i1-mod-cl-cf-J"}
