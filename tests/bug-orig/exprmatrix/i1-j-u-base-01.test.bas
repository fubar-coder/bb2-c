  vv=ia(-1.5 ^ 3.5) : !CheckEq{vv,65,"i1-pow-cf-cf-J"}
  vv=ia(vb EOR vq) : !CheckEq{vv,49,"i1-eor-b-q-J"}
  vv=ia(vw EOR vq) : !CheckEq{vv,289,"i1-eor-w-q-J"}
  vv=ia(vl EOR vq) : !CheckEq{vv,449,"i1-eor-l-q-J"}
