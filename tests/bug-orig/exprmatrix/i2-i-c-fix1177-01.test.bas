; i2-i-c-fix1177-01 - expression matrix: context i2, value set I,
; runtime error checking on, 4 cells
; fixed cells of #1177 (a comparison is computed in the type so far of
; its context, not with its operands' own values): the checks have the
; port's values, the original's are the declared deviations of the test
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
!TestCase{cells}
  vq.q=1.5
  Dim ja.l(1,300)
  For ii.l=0 To 300 : ja(1,ii)=ii*16+1 : Next
  vv.l=0
  vv=0 : SetErr : vv=-1 : Goto mx1 : End SetErr
  vv=ja(1,vq = 1.5)
  mx1:
  !CheckEq{vv,-1,"i2-eq-q-cf-I"}
  vv=0 : SetErr : vv=-1 : Goto mx2 : End SetErr
  vv=ja(1,vq <> 1.5)
  mx2:
  !CheckEq{vv,1,"i2-ne-q-cf-I"}
  vv=0 : SetErr : vv=-1 : Goto mx3 : End SetErr
  vv=ja(1,vq < 1.5)
  mx3:
  !CheckEq{vv,1,"i2-lt-q-cf-I"}
  vv=0 : SetErr : vv=-1 : Goto mx4 : End SetErr
  vv=ja(1,vq >= 1.5)
  mx4:
  !CheckEq{vv,-1,"i2-ge-q-cf-I"}
  ClrErr
!EndTestCase
