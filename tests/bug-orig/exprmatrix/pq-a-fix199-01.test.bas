; pq-a-fix199-01 - expression matrix: context pq, value set A, 13 cells
; fixed cells of #199 (the CD's quickmult adds the high words' product
; beyond the Quick range): the checks have the port's values, the
; original's are the declared deviations of the test
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
DEFTYPE .q gq
Statement pq{x.q}
  SHARED gq
  gq=x
End Statement
!TestCase{cells}
  vb.b=3 : vw.w=1000 : vl.l=100000
  pq{vb * vl} : !CheckEq{Peek.l(&gq),$93E00000,"pq-mul-b-l-A"}
  pq{vw * vw} : !CheckEq{Peek.l(&gq),$42400000,"pq-mul-w-w-A"}
  pq{vw * vl} : !CheckEq{Peek.l(&gq),$E1000000,"pq-mul-w-l-A"}
  pq{vw * 1000} : !CheckEq{Peek.l(&gq),$42400000,"pq-mul-w-cw-A"}
  pq{vl * vb} : !CheckEq{Peek.l(&gq),$93E00000,"pq-mul-l-b-A"}
  pq{vl * vw} : !CheckEq{Peek.l(&gq),$E1000000,"pq-mul-l-w-A"}
  pq{vl * vl} : !CheckEq{Peek.l(&gq),$E4000000,"pq-mul-l-l-A"}
  pq{vl * 3} : !CheckEq{Peek.l(&gq),$93E00000,"pq-mul-l-cb-A"}
  pq{vl * 1000} : !CheckEq{Peek.l(&gq),$E1000000,"pq-mul-l-cw-A"}
  pq{3 * vl} : !CheckEq{Peek.l(&gq),$93E00000,"pq-mul-cb-l-A"}
  pq{1000 * vw} : !CheckEq{Peek.l(&gq),$42400000,"pq-mul-cw-w-A"}
  pq{1000 * vl} : !CheckEq{Peek.l(&gq),$E1000000,"pq-mul-cw-l-A"}
  pq{1000 * 1000} : !CheckEq{Peek.l(&gq),$42400000,"pq-mul-cw-cw-A"}
!EndTestCase
