; dq-b-fix199-01 - expression matrix: context dq, value set B, 13 cells
; fixed cells of #199 (the CD's quickmult adds the high words' product
; beyond the Quick range): the checks have the port's values, the
; original's are the declared deviations of the test
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
!TestCase{cells}
  vb.b=-3 : vw.w=-1000 : vl.l=-100000
  rq.q=0
  rq=vb * vl : !CheckEq{Peek.l(&rq),$93E00000,"dq-mul-b-l-B"}
  rq=vw * vw : !CheckEq{Peek.l(&rq),$42400000,"dq-mul-w-w-B"}
  rq=vw * vl : !CheckEq{Peek.l(&rq),$E1000000,"dq-mul-w-l-B"}
  rq=vw * -1000 : !CheckEq{Peek.l(&rq),$42400000,"dq-mul-w-cw-B"}
  rq=vl * vb : !CheckEq{Peek.l(&rq),$93E00000,"dq-mul-l-b-B"}
  rq=vl * vw : !CheckEq{Peek.l(&rq),$E1000000,"dq-mul-l-w-B"}
  rq=vl * vl : !CheckEq{Peek.l(&rq),$E4000000,"dq-mul-l-l-B"}
  rq=vl * -3 : !CheckEq{Peek.l(&rq),$93E00000,"dq-mul-l-cb-B"}
  rq=vl * -1000 : !CheckEq{Peek.l(&rq),$E1000000,"dq-mul-l-cw-B"}
  rq=-3 * vl : !CheckEq{Peek.l(&rq),$93E00000,"dq-mul-cb-l-B"}
  rq=-1000 * vw : !CheckEq{Peek.l(&rq),$42400000,"dq-mul-cw-w-B"}
  rq=-1000 * vl : !CheckEq{Peek.l(&rq),$E1000000,"dq-mul-cw-l-B"}
  rq=-1000 * -1000 : !CheckEq{Peek.l(&rq),$42400000,"dq-mul-cw-cw-B"}
!EndTestCase
