; dq-a-fix199-01 - expression matrix: context dq, value set A, 13 cells
; fixed cells of #199 (the CD's quickmult adds the high words' product
; beyond the Quick range): the checks have the port's values, the
; original's are the declared deviations of the test
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
!TestCase{cells}
  vb.b=3 : vw.w=1000 : vl.l=100000
  rq.q=0
  rq=vb * vl : !CheckEq{Peek.l(&rq),$93E00000,"dq-mul-b-l-A"}
  rq=vw * vw : !CheckEq{Peek.l(&rq),$42400000,"dq-mul-w-w-A"}
  rq=vw * vl : !CheckEq{Peek.l(&rq),$E1000000,"dq-mul-w-l-A"}
  rq=vw * 1000 : !CheckEq{Peek.l(&rq),$42400000,"dq-mul-w-cw-A"}
  rq=vl * vb : !CheckEq{Peek.l(&rq),$93E00000,"dq-mul-l-b-A"}
  rq=vl * vw : !CheckEq{Peek.l(&rq),$E1000000,"dq-mul-l-w-A"}
  rq=vl * vl : !CheckEq{Peek.l(&rq),$E4000000,"dq-mul-l-l-A"}
  rq=vl * 3 : !CheckEq{Peek.l(&rq),$93E00000,"dq-mul-l-cb-A"}
  rq=vl * 1000 : !CheckEq{Peek.l(&rq),$E1000000,"dq-mul-l-cw-A"}
  rq=3 * vl : !CheckEq{Peek.l(&rq),$93E00000,"dq-mul-cb-l-A"}
  rq=1000 * vw : !CheckEq{Peek.l(&rq),$42400000,"dq-mul-cw-w-A"}
  rq=1000 * vl : !CheckEq{Peek.l(&rq),$E1000000,"dq-mul-cw-l-A"}
  rq=1000 * 1000 : !CheckEq{Peek.l(&rq),$42400000,"dq-mul-cw-cw-A"}
!EndTestCase
