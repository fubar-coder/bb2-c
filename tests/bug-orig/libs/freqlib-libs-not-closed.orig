# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
cancel 0
inject: rc=0
inject: opencount: dos.library +1
inject: opencount: intuition.library +1
inject: opencount: graphics.library +1
inject: click FQ/CANCEL: answered
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/freqlib-libs-not-closed.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/freqlib-libs-not-closed
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
