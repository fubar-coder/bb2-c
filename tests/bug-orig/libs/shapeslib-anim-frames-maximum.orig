# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
# varies: the shape objects written behind the table hold addresses (allocations of the frames)
behind 00100004000100020102000000000001*
shape 99 16 01
inject: rc=0
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/shapeslib-anim-frames-maximum.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/shapeslib-anim-frames-maximum
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
