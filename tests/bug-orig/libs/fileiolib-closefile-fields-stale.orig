# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
open reclen 6 fields -1
closed reclen 6 fields -1
fields again reclen 7
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/fileiolib-closefile-fields-stale.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/fileiolib-closefile-fields-stale
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
