# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
colour 0 100 311 522 733 944 B55 D66 F77 188 399 5AA 7BB 9CC BDD DEE FFF
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/fadelib-calcfade-palette-bits.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/fadelib-calcfade-palette-bits
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
