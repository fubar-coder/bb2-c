# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
a <-.00000000000000000002710505>
b <.0000000000000000001626303>
c <1E+18> <9.5E+19> <9.922337E+19>
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/printlib-ffptoascii-tiny-overflow.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/printlib-ffptoascii-tiny-overflow
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
