# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
rate 400 pitch 320 vol 64 freq 28000
rate 40 pitch 65 vol -32000 freq 28000
rate 400 pitch 320 vol 64 freq 28000
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/speaklib-setvoice-limits.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/speaklib-setvoice-limits
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
