# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
depth 0: body 3 frames 1 deltas -1
width 0: body 3 frames 1 deltas -1
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/animlib-zero-dimensions-load.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/animlib-zero-dimensions-load
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
