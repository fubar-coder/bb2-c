# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
BODY 12 01 01 02 01 05 05 02 05 06 07 00 08
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/iffmakelib-savearow-overread.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/iffmakelib-savearow-overread
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
