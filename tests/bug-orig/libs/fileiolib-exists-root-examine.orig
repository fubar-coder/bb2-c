# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
drawer -1
root SYS: -1
root RAM: -1
file 100
examine failed 100
inject: examinefail: 1 examines failed
inject: rc=0
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/fileiolib-exists-root-examine.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/fileiolib-exists-root-examine
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
