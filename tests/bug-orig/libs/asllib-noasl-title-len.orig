# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
file not 0
path not 0
inject: openlibfail: 1 opens failed
inject: rc=0
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/asllib-noasl-title-len.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/asllib-noasl-title-len
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
