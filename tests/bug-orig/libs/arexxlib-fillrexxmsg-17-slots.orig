# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
fill passport 0 slot16 -1
clear passport 0 host 0 slot16 0
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/arexxlib-fillrexxmsg-17-slots.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/arexxlib-fillrexxmsg-17-slots
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
