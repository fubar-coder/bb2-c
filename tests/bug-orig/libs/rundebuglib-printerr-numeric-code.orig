# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
child 1
REQUESTER: AutoRequest body "" pos "OKAY!" neg "OKAY!" -> answered FALSE
child 2
REQUESTER: AutoRequest body "" pos "OKAY!" neg "OKAY!" -> answered FALSE
parent
REQUESTER: AutoRequest body "" pos "OKAY!" neg "OKAY!" -> answered FALSE
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/rundebuglib-printerr-numeric-code.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/rundebuglib-printerr-numeric-code
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
