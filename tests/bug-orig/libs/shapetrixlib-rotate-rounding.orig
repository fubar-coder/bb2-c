# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
quarter 10 21 pixels 189
half 22 10 pixels 189
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/shapetrixlib-rotate-rounding.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/shapetrixlib-rotate-rounding
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
