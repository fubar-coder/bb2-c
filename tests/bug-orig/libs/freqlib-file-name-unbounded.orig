# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
cancel 0
file buffer (64 bytes): 70 characters
inject: rc=0
# varies: the 40-byte list node of the original holds a name of at most 34 characters (#159, fixed in the port): pad reports the overrun of the original, the port has none
...
inject: click FQ/a123456789b123456789c123456: answered
inject: click FQ/CANCEL: answered
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/freqlib-file-name-unbounded.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/freqlib-file-name-unbounded
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
