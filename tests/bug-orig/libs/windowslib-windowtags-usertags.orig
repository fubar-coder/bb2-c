# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
tags 100 100 120 60
again 100 100 120 60
same as first 0
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/windowslib-windowtags-usertags.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/windowslib-windowtags-usertags
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
