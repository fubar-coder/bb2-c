# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
waiting 1000
length 1000500
guard: 504 bytes overwritten
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/seriallib-readserialstring-unbounded.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/seriallib-readserialstring-unbounded
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
