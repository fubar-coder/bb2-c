# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
qangle 0 0 32767 0 00000000
qangle 0 0 -32768 0 0000C001
qangle -32768 0 0 0 0000C001
qangle 0 0 0 -32768 00004001
qangle 0 -32768 0 0 00004001
qangle 0 0 -32768 -32768 00002000
qangle 32767 0 -32768 0 00000000
qangle -32768 0 32767 0 00008001
qangle 0 32767 0 -32768 00004001
qangle 32767 32767 -32768 -32768 00002000
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/vallib-qangle-word-range.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/vallib-qangle-word-range
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
