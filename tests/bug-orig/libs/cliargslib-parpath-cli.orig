# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
numpars 1 datei.txt
parpath0 [SYS:]
parpath1 [SYS:datei.txt]
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/cliargslib-parpath-cli.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/cliargslib-parpath-cli
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
