# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
after Gameb(1): port 1 pin 5 1
after Gameb(0): port 0 pin 5 0
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/gameiolib-gameb-port0-exit.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/gameiolib-gameb-port0-exit
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
