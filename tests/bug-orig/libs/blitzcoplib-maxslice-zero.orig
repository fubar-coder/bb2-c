# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
# varies: the corrupted memory ends the session as a timeout or a halt of the CPU, depending on the memory layout (#406)
*
[compile]
ok
[run]
before
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/blitzcoplib-maxslice-zero.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/blitzcoplib-maxslice-zero
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
