# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
timeout
[compile]
ok
[run]
before
runtime error 
REQUESTER: EasyRequest title "Software Failure" text "%s
%s%lx).
%s" gadgets "Suspend|Reboot" -> answered 0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/animlib-errors-check-area.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/animlib-errors-check-area
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
