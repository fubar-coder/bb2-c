# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
row 0 1122
row 1 AAAA
row 2 AAAA
row 3 0000
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/ilbmifflib-byterun-unclipped.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/ilbmifflib-byterun-unclipped
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
