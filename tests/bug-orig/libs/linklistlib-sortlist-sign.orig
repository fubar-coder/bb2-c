# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
sorted 2000000000 -2000000000 5 2147483647 -2147483648
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/linklistlib-sortlist-sign.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/linklistlib-sortlist-sign
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
