# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
pal 0 cycle 0 0 1 -1000
pal 0 cycle 1 1 2 2000
pal 0 cycle 2 2 3 -3000
pal 1 cycle 0 0 1 -1000
pal 1 cycle 1 1 2 2000
pal 1 cycle 2 2 3 -3000
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/palettelib-crng-flags.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/palettelib-crng-flags
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
