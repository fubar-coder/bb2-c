# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
new eof -1
written loc 4 lof 4
exists 3
read [abc] eof -1 loc 4 lof 4
open seek 3 eof -1 loc 4 lof 4
exists 3
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/fileiolib-eof-loc-lof.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/fileiolib-eof-loc-lof
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
