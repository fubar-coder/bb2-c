# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
timeout
[compile]
ok
[run]
before
# varies: the crash shows the Software Failure requester, of which more or less is written before the session ends
REQUESTER: EasyRequest title "Software Failure" text "*
# varies: the rest of the requester, if it is written
...
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/displaylib-errors-errarea.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/displaylib-errors-errarea
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
