# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
closed, users 0
open with one free signal 0
users 1
open again failed
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/seriallib-openserial-writesig-fail.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/seriallib-openserial-writesig-fail
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
