# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
REQUESTER: AutoRequest body "Failed To Open Speech Library" pos "OKAY!" neg "OKAY!" -> answered FALSE
inject: opendevfail: 1 opens failed
inject: rc=0
inject: opencount: translator.library +0
inject: freesignal: 1 calls on a signal not allocated
inject: freesignal 0
inject: closedevice: 1 calls on a request without a device
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/speaklib-finit-without-init.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/speaklib-finit-without-init
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
