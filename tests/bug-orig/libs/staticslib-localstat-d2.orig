# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
s3 1 2 65520
s4 11 12 65516 14
s5 21 22 65512 24 25
f3 6552054
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/staticslib-localstat-d2.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/staticslib-localstat-d2
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
