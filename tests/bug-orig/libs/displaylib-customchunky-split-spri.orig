# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
spri before 1
spri after 0
chunky2 418 20 8 2 2 44
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/displaylib-customchunky-split-spri.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/displaylib-customchunky-split-spri
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
