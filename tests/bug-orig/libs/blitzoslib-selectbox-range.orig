# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
# varies: the original draws a box from the memory behind the table of 2 boxes (#82); whether it then returns or hangs depends on that memory, which differs between emulator snapshots
*
[compile]
ok
[run]
before
valid passed
# varies: the rest of the run depends on the same memory (#82): the original returns (after, rc=0) or hangs after valid passed
...
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/blitzoslib-selectbox-range.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/blitzoslib-selectbox-range
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
