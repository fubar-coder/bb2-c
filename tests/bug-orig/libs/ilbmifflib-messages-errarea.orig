# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
before
# varies: the message text is read from memory the bug points into, which depends on the memory layout
runtime error *
# varies: the message text is read from memory the bug points into, which depends on the memory layout
runtime error *
after
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/ilbmifflib-messages-errarea.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/ilbmifflib-messages-errarea
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
