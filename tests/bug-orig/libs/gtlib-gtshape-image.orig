# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
gadget 1 render shape 0 select shape 3
gadget 2 render shape 2 select shape 3
gadget 1 freed -1
freed
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/gtlib-gtshape-image.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/gtlib-gtshape-image
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
