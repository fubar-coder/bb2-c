# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
regs 0140 0142 0120 0122
pointer set 0
pos and ctl 0 0
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/displaylib-init-sprite-pointer.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/displaylib-init-sprite-pointer
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
