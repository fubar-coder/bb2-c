# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
flags 64 disabled 0
flags 128 immediate 0
control: button 64 disabled -1
control: button 128 immediate -1
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/gtlib-gtshape-flags.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/gtlib-gtshape-flags
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
