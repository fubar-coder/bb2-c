# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
a 2147483647
b 2147483647
c 2147483647
d 7FFFFFFF
e 7FFFFFFF
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/ldivlib-div0.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/ldivlib-div0
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
