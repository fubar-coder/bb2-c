# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
before
REQUESTER: AutoRequest body "Out of Memory!" pos "OKAY!" neg "OKAY!" -> answered FALSE
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/blitzoslib-initpage-numboxes.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/blitzoslib-initpage-numboxes
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
