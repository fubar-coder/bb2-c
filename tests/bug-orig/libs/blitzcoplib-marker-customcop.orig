# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
string 01FE1234 01800F00
len 20
list 00960020 6407FFFE FFE1FFFE 80010F00 FFFFFFFE
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/blitzcoplib-marker-customcop.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/blitzcoplib-marker-customcop
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
