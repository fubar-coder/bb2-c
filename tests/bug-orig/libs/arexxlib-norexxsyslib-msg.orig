# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
inject: alert: SORRY CAN NOT OPEN REXXSYSLIB.LIBRARY PRESS ANY MOUSE BUTTON TO CONTINUE
inject: alert: SORRY CAN NOT OPEN REXXSYSLIB.LIBRARY PRESS ANY MOUSE BUTTON TO CONTINUE
result 16255708
