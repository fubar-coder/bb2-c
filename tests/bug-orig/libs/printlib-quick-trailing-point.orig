# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
quick 00010001 <1.> <1.>
quick 00000001 <.> <.>
quick FFFFFFFF <-.> <-.>
quick 00050001 <5.> <5.>
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/printlib-quick-trailing-point.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/printlib-quick-trailing-point
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
