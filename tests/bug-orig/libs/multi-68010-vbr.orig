# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
timeout
[compile]
ok
[run]
cr_vbr is the moved table 0
REQUESTER: AutoRequest body "Software error - task held" " Finish ALL disk activity" "Select CANCEL to reset/debug" pos "Retry" neg "Cancel" -> answered FALSE
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/multi-68010-vbr.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/multi-68010-vbr
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
