# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
dimmed
inject: rc=0
inject: guard: written behind an allocation of 40 bytes
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/arrayslib-newlist-overrun.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/arrayslib-newlist-overrun
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
