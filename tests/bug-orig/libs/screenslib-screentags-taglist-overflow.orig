# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
timeout
[compile]
ok
[run]
illegal instruction
# varies: the program's end runs into the overwritten code and shows the Software Failure requester, of which more or less (none at all) is written before the session ends
...
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/screenslib-screentags-taglist-overflow.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/screenslib-screentags-taglist-overflow
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
