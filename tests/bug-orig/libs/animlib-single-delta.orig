# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
frames 0 deltas -1
init row 0000AABB
init current -1
row 0000CCDD
current is the node 0
row 0000CCE2
current is the node 0
rc=0
[blitz2]
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/animlib-single-delta.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/animlib-single-delta
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
BATCH	end
