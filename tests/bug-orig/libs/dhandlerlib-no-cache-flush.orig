# the original blitz2 1.95 (the build of blitz2.s) with the CD's libraries
[session]
done
[compile]
ok
[run]
hello
rc=0
[blitz2]
inject: rc=0
inject: CreateProc Debug: caches not flushed before
rc=0
[log]
openreq "Blitz Basic 2 Version N.NN"
getinput "Blitz Basic 2 Version N.NN" -> gadget 1 " OKEE DOKEE " (version requester)
BATCH	start
JOB	j000	CORPUS:src/dhandlerlib-no-cache-flush.bb2
XTRA	j000	defaults
ezfreq "Name of Executable to create" -> CORPUS:out/dhandlerlib-no-cache-flush
openreq "***** COMPILING *****"
openreq "***** COMPILING *****"
RESULT	j000	ok
JOB	r001	CORPUS:src/dhandlerlib-no-cache-flush.bb2
XTRA	r001	defaults
openreq "***** COMPILING *****"
openreq "***** EXECUTING *****"
OPENIO	r001
CLOSEIO	r001
OUTPUT	r001	hello
REQUESTERS	r001	0
BATCH	end
