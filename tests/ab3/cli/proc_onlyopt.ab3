; name{} of a Statement and a Function whose parameters are all optional
OPTIMIZE 4
Statement s{@a.l,@t.s}
NPrint "s ",a," [",t,"] ",Len(t)
End Statement
Function.l f{@a.l,@t.s}
NPrint "f ",a," [",t,"] ",Len(t)
Function Return a
End Function
s{}
s{5}
s{6,"x"}
r.l=f{}
NPrint r
r=f{7}
NPrint r
NPrint "end"
End
