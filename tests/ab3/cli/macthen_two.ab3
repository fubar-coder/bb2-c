; two one-line Ifs on one macro line: one End If each (AmiBlitz3 appends
; one, the outer If stays open to the end of the expanded line)
Macro t
If `1 > 0 Then If `2 > 0 Then `2 = 0
`3 = 1
End Macro
Macro u
If `1 > 0 Then If `2 > 0 Then `2 = 0 : End If
`3 = 1
End Macro
a.l = 0 : b.l = 5 : c.l = 0
!t{a, b, c}
NPrint a, " ", b, " ", c
a = 1 : b = 5 : c = 0
!t{a, b, c}
NPrint a, " ", b, " ", c
a = 0 : b = 5 : c = 0
!u{a, b, c}
NPrint a, " ", b, " ", c
End
