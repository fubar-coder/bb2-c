; Int of a Quick in AB3 mode (change compiler-intrinsics, spec
; compiler/intrinsics): the integer part truncated towards zero, compiled
; inline by blitz2-ab3 ("extra calls 0": the JSRs of the statement minus
; those of the same statement without Int); AmiBlitz3 calls its library
; (REF_EXPECT: its count), with the same values
Function.l jsrs{a.l,b.l}
  n.l = 0
  While a < b
    If Peek.w(a) = $4EB9
      n = n + 1 : a = a + 4
    EndIf
    a = a + 2
  Wend
  Function Return n
End Function
c.l = 0 : q.q = 0
q = 3.5 : c = Int(q) : NPrint c
q = -3.5 : c = Int(q) : NPrint c
q = 2.5 : c = Int(q) : NPrint c
q = -2.5 : c = Int(q) : NPrint c
q = 1.5 : c = Int(q) : NPrint c
q = -1.75 : c = Int(q) : NPrint c
q = -0.5 : c = Int(q) : NPrint c
q = -32768 : c = Int(q) : NPrint c
q = -1.75
.a3
c = q
.a4
.a1
c = Int(q)
.a2
NPrint c, " extra calls ", jsrs{?a1, ?a2} - jsrs{?a3, ?a4}
End
