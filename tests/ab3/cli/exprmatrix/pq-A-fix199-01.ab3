; pq-A-fix199-01 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/pq-A-fix199-01.bas: 13 of its 13 cells
; pq-A-fix199-01.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vb.b=3 : vw.w=1000 : vl.l=100000
tq.q=0
Statement pq{x.q}
  SHARED tq
  tq=x : NPrint Hex$(Peek.l(&tq))
End Statement
Print "pq-mul-b-l-A " : pq{vb * vl}
Print "pq-mul-w-w-A " : pq{vw * vw}
Print "pq-mul-w-l-A " : pq{vw * vl}
Print "pq-mul-w-cw-A " : pq{vw * 1000}
Print "pq-mul-l-b-A " : pq{vl * vb}
Print "pq-mul-l-w-A " : pq{vl * vw}
Print "pq-mul-l-l-A " : pq{vl * vl}
Print "pq-mul-l-cb-A " : pq{vl * 3}
Print "pq-mul-l-cw-A " : pq{vl * 1000}
Print "pq-mul-cb-l-A " : pq{3 * vl}
Print "pq-mul-cw-w-A " : pq{1000 * vw}
Print "pq-mul-cw-l-A " : pq{1000 * vl}
Print "pq-mul-cw-cw-A " : pq{1000 * 1000}
End
