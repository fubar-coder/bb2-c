; pw-A-agree-18 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/pw-A-agree-18.bas: 17 of its 17 cells
; pw-A-agree-18.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vl.l=100000 : vq.q=1.5 : vf.f=2.5 : vs$="AB"
Statement pw{x.w}
  NPrint x
End Statement
Print "pw-ge-cf-l-A " : pw{1.5 >= vl}
Print "pw-ge-cf-q-A " : pw{1.5 >= vq}
Print "pw-ge-cf-f-A " : pw{1.5 >= vf}
Print "pw-ge-cf-cb-A " : pw{1.5 >= 3}
Print "pw-ge-cf-cw-A " : pw{1.5 >= 1000}
Print "pw-ge-cf-cl-A " : pw{1.5 >= 100000}
Print "pw-ge-cf-cf-A " : pw{1.5 >= 1.5}
Print "pw-eq-s-s-A " : pw{vs$ = vs$}
Print "pw-ne-s-s-A " : pw{vs$ <> vs$}
Print "pw-lt-s-s-A " : pw{vs$ < vs$}
Print "pw-le-s-s-A " : pw{vs$ <= vs$}
Print "pw-gt-s-s-A " : pw{vs$ > vs$}
Print "pw-ge-s-s-A " : pw{vs$ >= vs$}
Print "pw-mod-cb-cb-A " : pw{3 MOD 3}
Print "pw-mod-cb-cw-A " : pw{3 MOD 1000}
Print "pw-mod-cw-cb-A " : pw{1000 MOD 3}
Print "pw-mod-cw-cw-A " : pw{1000 MOD 1000}
End
