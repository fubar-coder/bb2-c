; i1-J-u-agree-08 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/i1-J-u-agree-08.bas: 32 of its 32 cells
; i1-J-u-agree-08.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vb.b=-3 : vw.w=-20 : vl.l=-30 : vq.q=-1.5 : vf.f=-2.5
Dim ia.l(300)
For ii.l=0 To 300 : ia(ii)=ii*16+1 : Next
NPrint "i1-ge-b-cf-J ",ia(vb >= -1.5)
NPrint "i1-ge-w-b-J ",ia(vw >= vb)
NPrint "i1-ge-w-q-J ",ia(vw >= vq)
NPrint "i1-ge-w-f-J ",ia(vw >= vf)
NPrint "i1-ge-w-cb-J ",ia(vw >= -3)
NPrint "i1-ge-w-cf-J ",ia(vw >= -1.5)
NPrint "i1-ge-l-b-J ",ia(vl >= vb)
NPrint "i1-ge-l-w-J ",ia(vl >= vw)
NPrint "i1-ge-l-q-J ",ia(vl >= vq)
NPrint "i1-ge-l-f-J ",ia(vl >= vf)
NPrint "i1-ge-l-cb-J ",ia(vl >= -3)
NPrint "i1-ge-l-cf-J ",ia(vl >= -1.5)
NPrint "i1-ge-f-q-J ",ia(vf >= vq)
NPrint "i1-ge-f-cf-J ",ia(vf >= -1.5)
NPrint "i1-ge-cb-q-J ",ia(-3 >= vq)
NPrint "i1-ge-cb-f-J ",ia(-3 >= vf)
NPrint "i1-ge-cb-cf-J ",ia(-3 >= -1.5)
NPrint "i1-ge-cw-b-J ",ia(-200 >= vb)
NPrint "i1-ge-cw-w-J ",ia(-200 >= vw)
NPrint "i1-ge-cw-l-J ",ia(-200 >= vl)
NPrint "i1-ge-cw-q-J ",ia(-200 >= vq)
NPrint "i1-ge-cw-f-J ",ia(-200 >= vf)
NPrint "i1-ge-cw-cb-J ",ia(-200 >= -3)
NPrint "i1-ge-cw-cf-J ",ia(-200 >= -1.5)
NPrint "i1-ge-cl-b-J ",ia(-40000 >= vb)
NPrint "i1-ge-cl-w-J ",ia(-40000 >= vw)
NPrint "i1-ge-cl-l-J ",ia(-40000 >= vl)
NPrint "i1-ge-cl-q-J ",ia(-40000 >= vq)
NPrint "i1-ge-cl-f-J ",ia(-40000 >= vf)
NPrint "i1-ge-cl-cb-J ",ia(-40000 >= -3)
NPrint "i1-ge-cl-cw-J ",ia(-40000 >= -200)
NPrint "i1-ge-cl-cf-J ",ia(-40000 >= -1.5)
End
