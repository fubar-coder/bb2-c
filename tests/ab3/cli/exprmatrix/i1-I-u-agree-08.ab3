NPrint "i1-asr-w-w-I ",ia(vw ASR nw)
NPrint "i1-asr-w-l-I ",ia(vw ASR nl)
NPrint "i1-asr-w-cb-I ",ia(vw ASR 2)
NPrint "i1-asr-w-cw-I ",ia(vw ASR 2)
NPrint "i1-asr-w-cl-I ",ia(vw ASR 2)
NPrint "i1-asr-l-b-I ",ia(vl ASR nb)
