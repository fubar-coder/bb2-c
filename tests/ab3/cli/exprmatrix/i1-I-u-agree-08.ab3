; do not edit
vb.b=3 : vw.w=20 : vl.l=30
nb.b=2 : nw.w=2 : nl.l=2
Dim ia.l(300)
For ii.l=0 To 300 : ia(ii)=ii*16+1 : Next
NPrint "i1-lsr-cw-l-I ",ia(200 LSR nl)
