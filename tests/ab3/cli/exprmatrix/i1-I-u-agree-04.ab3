; i1-I-u-agree-04 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/i1-I-u-agree-04.bas: 56 of its 56 cells
; i1-I-u-agree-04.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vb.b=3 : vw.w=20 : vl.l=30 : vq.q=1.5 : vf.f=2.5
Dim ia.l(300)
For ii.l=0 To 300 : ia(ii)=ii*16+1 : Next
NPrint "i1-div-f-f-I ",ia(vf / vf)
NPrint "i1-div-f-cb-I ",ia(vf / 3)
NPrint "i1-div-f-cw-I ",ia(vf / 200)
NPrint "i1-div-f-cl-I ",ia(vf / 40000)
NPrint "i1-div-f-cf-I ",ia(vf / 1.5)
NPrint "i1-div-cb-b-I ",ia(3 / vb)
NPrint "i1-div-cb-w-I ",ia(3 / vw)
NPrint "i1-div-cb-l-I ",ia(3 / vl)
NPrint "i1-div-cb-f-I ",ia(3 / vf)
NPrint "i1-div-cb-cb-I ",ia(3 / 3)
NPrint "i1-div-cb-cw-I ",ia(3 / 200)
NPrint "i1-div-cb-cl-I ",ia(3 / 40000)
NPrint "i1-div-cb-cf-I ",ia(3 / 1.5)
NPrint "i1-div-cw-b-I ",ia(200 / vb)
NPrint "i1-div-cw-w-I ",ia(200 / vw)
NPrint "i1-div-cw-l-I ",ia(200 / vl)
NPrint "i1-div-cw-f-I ",ia(200 / vf)
NPrint "i1-div-cw-cb-I ",ia(200 / 3)
NPrint "i1-div-cw-cw-I ",ia(200 / 200)
NPrint "i1-div-cw-cl-I ",ia(200 / 40000)
NPrint "i1-div-cw-cf-I ",ia(200 / 1.5)
NPrint "i1-div-cl-cw-I ",ia(40000 / 200)
NPrint "i1-div-cl-cl-I ",ia(40000 / 40000)
NPrint "i1-div-cf-b-I ",ia(1.5 / vb)
NPrint "i1-div-cf-w-I ",ia(1.5 / vw)
NPrint "i1-div-cf-l-I ",ia(1.5 / vl)
NPrint "i1-div-cf-q-I ",ia(1.5 / vq)
NPrint "i1-div-cf-f-I ",ia(1.5 / vf)
NPrint "i1-div-cf-cb-I ",ia(1.5 / 3)
NPrint "i1-div-cf-cw-I ",ia(1.5 / 200)
NPrint "i1-div-cf-cl-I ",ia(1.5 / 40000)
NPrint "i1-div-cf-cf-I ",ia(1.5 / 1.5)
NPrint "i1-mod-b-b-I ",ia(vb MOD vb)
NPrint "i1-mod-b-w-I ",ia(vb MOD vw)
NPrint "i1-mod-b-l-I ",ia(vb MOD vl)
NPrint "i1-mod-b-cb-I ",ia(vb MOD 3)
NPrint "i1-mod-b-cw-I ",ia(vb MOD 200)
NPrint "i1-mod-b-cl-I ",ia(vb MOD 40000)
NPrint "i1-mod-w-b-I ",ia(vw MOD vb)
NPrint "i1-mod-w-w-I ",ia(vw MOD vw)
NPrint "i1-mod-w-l-I ",ia(vw MOD vl)
NPrint "i1-mod-w-cb-I ",ia(vw MOD 3)
NPrint "i1-mod-w-cw-I ",ia(vw MOD 200)
NPrint "i1-mod-w-cl-I ",ia(vw MOD 40000)
NPrint "i1-mod-l-b-I ",ia(vl MOD vb)
NPrint "i1-mod-l-w-I ",ia(vl MOD vw)
NPrint "i1-mod-l-l-I ",ia(vl MOD vl)
