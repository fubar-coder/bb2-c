; do not edit
vb.b=3 : vw.w=1000 : vl.l=100000
tq.q=0
Statement pq{x.q}
  SHARED tq
  tq=x : NPrint Hex$(Peek.l(&tq))
End Statement
Print "pq-mod-cb-w-A " : pq{3 MOD vw}
