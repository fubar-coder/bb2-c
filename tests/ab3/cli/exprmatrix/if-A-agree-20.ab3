; if-A-agree-20 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/if-A-agree-20.bas: 15 of its 15 cells
; if-A-agree-20.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vf.f=2.5 : vs$="AB"
If 1.5 >= vf Then NPrint "if-ge-cf-f-A T" Else NPrint "if-ge-cf-f-A F"
If 1.5 >= 3 Then NPrint "if-ge-cf-cb-A T" Else NPrint "if-ge-cf-cb-A F"
If 1.5 >= 1000 Then NPrint "if-ge-cf-cw-A T" Else NPrint "if-ge-cf-cw-A F"
If 1.5 >= 100000 Then NPrint "if-ge-cf-cl-A T" Else NPrint "if-ge-cf-cl-A F"
If 1.5 >= 1.5 Then NPrint "if-ge-cf-cf-A T" Else NPrint "if-ge-cf-cf-A F"
If vs$ = vs$ Then NPrint "if-eq-s-s-A T" Else NPrint "if-eq-s-s-A F"
If vs$ <> vs$ Then NPrint "if-ne-s-s-A T" Else NPrint "if-ne-s-s-A F"
If vs$ < vs$ Then NPrint "if-lt-s-s-A T" Else NPrint "if-lt-s-s-A F"
If vs$ <= vs$ Then NPrint "if-le-s-s-A T" Else NPrint "if-le-s-s-A F"
If vs$ > vs$ Then NPrint "if-gt-s-s-A T" Else NPrint "if-gt-s-s-A F"
If vs$ >= vs$ Then NPrint "if-ge-s-s-A T" Else NPrint "if-ge-s-s-A F"
If 3 MOD 3 Then NPrint "if-mod-cb-cb-A T" Else NPrint "if-mod-cb-cb-A F"
If 3 MOD 1000 Then NPrint "if-mod-cb-cw-A T" Else NPrint "if-mod-cb-cw-A F"
If 1000 MOD 3 Then NPrint "if-mod-cw-cb-A T" Else NPrint "if-mod-cw-cb-A F"
If 1000 MOD 1000 Then NPrint "if-mod-cw-cw-A T" Else NPrint "if-mod-cw-cw-A F"
End
