; pq-B-agree-04 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/pq-B-agree-04.bas: 56 of its 56 cells
; pq-B-agree-04.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vb.b=-3 : vw.w=-1000 : vl.l=-100000 : vq.q=-1.5 : vf.f=-2.5
tq.q=0
Statement pq{x.q}
  SHARED tq
  tq=x : NPrint Hex$(Peek.l(&tq))
End Statement
Print "pq-div-q-b-B " : pq{vq / vb}
Print "pq-div-q-w-B " : pq{vq / vw}
Print "pq-div-q-q-B " : pq{vq / vq}
Print "pq-div-q-f-B " : pq{vq / vf}
Print "pq-div-q-cb-B " : pq{vq / -3}
Print "pq-div-q-cw-B " : pq{vq / -1000}
Print "pq-div-q-cl-B " : pq{vq / -100000}
Print "pq-div-q-cf-B " : pq{vq / -1.5}
Print "pq-div-f-b-B " : pq{vf / vb}
Print "pq-div-f-w-B " : pq{vf / vw}
Print "pq-div-f-l-B " : pq{vf / vl}
Print "pq-div-f-q-B " : pq{vf / vq}
Print "pq-div-f-f-B " : pq{vf / vf}
Print "pq-div-f-cb-B " : pq{vf / -3}
Print "pq-div-f-cw-B " : pq{vf / -1000}
Print "pq-div-f-cl-B " : pq{vf / -100000}
Print "pq-div-f-cf-B " : pq{vf / -1.5}
Print "pq-div-cb-b-B " : pq{-3 / vb}
Print "pq-div-cb-w-B " : pq{-3 / vw}
