Print "pq-div-cb-f-B " : pq{-3 / vf}
Print "pq-div-cb-cb-B " : pq{-3 / -3}
Print "pq-div-cb-cw-B " : pq{-3 / -1000}
Print "pq-div-cb-cl-B " : pq{-3 / -100000}
Print "pq-div-cb-cf-B " : pq{-3 / -1.5}
Print "pq-div-cw-b-B " : pq{-1000 / vb}
Print "pq-div-cw-w-B " : pq{-1000 / vw}
Print "pq-div-cw-q-B " : pq{-1000 / vq}
Print "pq-div-cw-f-B " : pq{-1000 / vf}
Print "pq-div-cw-cb-B " : pq{-1000 / -3}
Print "pq-div-cw-cw-B " : pq{-1000 / -1000}
Print "pq-div-cw-cl-B " : pq{-1000 / -100000}
Print "pq-div-cw-cf-B " : pq{-1000 / -1.5}
Print "pq-div-cl-w-B " : pq{-100000 / vw}
Print "pq-div-cl-l-B " : pq{-100000 / vl}
Print "pq-div-cl-cw-B " : pq{-100000 / -1000}
Print "pq-div-cl-cl-B " : pq{-100000 / -100000}
Print "pq-div-cf-b-B " : pq{-1.5 / vb}
Print "pq-div-cf-w-B " : pq{-1.5 / vw}
Print "pq-div-cf-q-B " : pq{-1.5 / vq}
Print "pq-div-cf-f-B " : pq{-1.5 / vf}
Print "pq-div-cf-cb-B " : pq{-1.5 / -3}
Print "pq-div-cf-cw-B " : pq{-1.5 / -1000}
