; dl-A-agree-20 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/dl-A-agree-20.bas: 35 of its 35 cells
; dl-A-agree-20.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vb.b=3 : vw.w=1000 : vl.l=100000 : vq.q=1.5 : vf.f=2.5 : vs$="AB"
rl.l=0
rl=(3 >= 100000) : NPrint "dl-ge-cb-cl-A ",rl
rl=(3 >= 1.5) : NPrint "dl-ge-cb-cf-A ",rl
rl=(1000 >= vb) : NPrint "dl-ge-cw-b-A ",rl
rl=(1000 >= vw) : NPrint "dl-ge-cw-w-A ",rl
rl=(1000 >= vl) : NPrint "dl-ge-cw-l-A ",rl
rl=(1000 >= vq) : NPrint "dl-ge-cw-q-A ",rl
rl=(1000 >= vf) : NPrint "dl-ge-cw-f-A ",rl
rl=(1000 >= 3) : NPrint "dl-ge-cw-cb-A ",rl
rl=(1000 >= 1000) : NPrint "dl-ge-cw-cw-A ",rl
rl=(1000 >= 100000) : NPrint "dl-ge-cw-cl-A ",rl
rl=(1000 >= 1.5) : NPrint "dl-ge-cw-cf-A ",rl
rl=(100000 >= vb) : NPrint "dl-ge-cl-b-A ",rl
rl=(100000 >= vw) : NPrint "dl-ge-cl-w-A ",rl
rl=(100000 >= vl) : NPrint "dl-ge-cl-l-A ",rl
rl=(100000 >= vq) : NPrint "dl-ge-cl-q-A ",rl
rl=(100000 >= vf) : NPrint "dl-ge-cl-f-A ",rl
rl=(100000 >= 3) : NPrint "dl-ge-cl-cb-A ",rl
rl=(100000 >= 1000) : NPrint "dl-ge-cl-cw-A ",rl
rl=(100000 >= 100000) : NPrint "dl-ge-cl-cl-A ",rl
rl=(100000 >= 1.5) : NPrint "dl-ge-cl-cf-A ",rl
rl=(1.5 >= vb) : NPrint "dl-ge-cf-b-A ",rl
rl=(1.5 >= vw) : NPrint "dl-ge-cf-w-A ",rl
rl=(1.5 >= vl) : NPrint "dl-ge-cf-l-A ",rl
rl=(1.5 >= vq) : NPrint "dl-ge-cf-q-A ",rl
rl=(1.5 >= vf) : NPrint "dl-ge-cf-f-A ",rl
rl=(1.5 >= 3) : NPrint "dl-ge-cf-cb-A ",rl
rl=(1.5 >= 1000) : NPrint "dl-ge-cf-cw-A ",rl
rl=(1.5 >= 100000) : NPrint "dl-ge-cf-cl-A ",rl
rl=(1.5 >= 1.5) : NPrint "dl-ge-cf-cf-A ",rl
rl=(vs$ = vs$) : NPrint "dl-eq-s-s-A ",rl
rl=(vs$ <> vs$) : NPrint "dl-ne-s-s-A ",rl
rl=(vs$ < vs$) : NPrint "dl-lt-s-s-A ",rl
rl=(vs$ <= vs$) : NPrint "dl-le-s-s-A ",rl
rl=(vs$ > vs$) : NPrint "dl-gt-s-s-A ",rl
rl=(vs$ >= vs$) : NPrint "dl-ge-s-s-A ",rl
End
