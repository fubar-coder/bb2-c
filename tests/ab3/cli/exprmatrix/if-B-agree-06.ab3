If -100000 / vf Then NPrint "if-div-cl-f-B T" Else NPrint "if-div-cl-f-B F"
If -100000 / -3 Then NPrint "if-div-cl-cb-B T" Else NPrint "if-div-cl-cb-B F"
If -100000 / -1000 Then NPrint "if-div-cl-cw-B T" Else NPrint "if-div-cl-cw-B F"
If -100000 / -100000 Then NPrint "if-div-cl-cl-B T" Else NPrint "if-div-cl-cl-B F"
If -1.5 / vb Then NPrint "if-div-cf-b-B T" Else NPrint "if-div-cf-b-B F"
