If -1000 / vf Then NPrint "if-div-cw-f-B T" Else NPrint "if-div-cw-f-B F"
If -1000 / -3 Then NPrint "if-div-cw-cb-B T" Else NPrint "if-div-cw-cb-B F"
If -1000 / -1000 Then NPrint "if-div-cw-cw-B T" Else NPrint "if-div-cw-cw-B F"
