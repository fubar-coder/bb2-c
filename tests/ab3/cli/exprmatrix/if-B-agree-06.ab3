If -3 AND -3 Then NPrint "if-and-cb-cb-B T" Else NPrint "if-and-cb-cb-B F"
If -3 AND -1000 Then NPrint "if-and-cb-cw-B T" Else NPrint "if-and-cb-cw-B F"
If -3 AND -100000 Then NPrint "if-and-cb-cl-B T" Else NPrint "if-and-cb-cl-B F"
If -1000 AND vb Then NPrint "if-and-cw-b-B T" Else NPrint "if-and-cw-b-B F"
If -1000 AND vw Then NPrint "if-and-cw-w-B T" Else NPrint "if-and-cw-w-B F"
