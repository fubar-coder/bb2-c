NPrint "i2-eq-cb-cl-I ",ja(1,3 = 40000)
NPrint "i2-eq-cb-cf-I ",ja(1,3 = 1.5)
NPrint "i2-eq-cw-b-I ",ja(1,200 = vb)
NPrint "i2-eq-cw-w-I ",ja(1,200 = vw)
NPrint "i2-eq-cw-l-I ",ja(1,200 = vl)
