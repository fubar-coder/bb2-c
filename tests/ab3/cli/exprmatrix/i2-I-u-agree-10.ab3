NPrint "i2-eq-cl-l-I ",ja(1,40000 = vl)
NPrint "i2-eq-cl-q-I ",ja(1,40000 = vq)
NPrint "i2-eq-cl-f-I ",ja(1,40000 = vf)
NPrint "i2-eq-cl-cb-I ",ja(1,40000 = 3)
NPrint "i2-eq-cl-cw-I ",ja(1,40000 = 200)
NPrint "i2-eq-cl-cf-I ",ja(1,40000 = 1.5)
