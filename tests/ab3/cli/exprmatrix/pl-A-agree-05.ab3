Print "pl-div-l-cb-A " : pl{vl / 3}
Print "pl-div-l-cw-A " : pl{vl / 1000}
Print "pl-div-l-cl-A " : pl{vl / 100000}
Print "pl-div-l-cf-A " : pl{vl / 1.5}
Print "pl-div-q-b-A " : pl{vq / vb}
Print "pl-div-q-w-A " : pl{vq / vw}
Print "pl-div-q-l-A " : pl{vq / vl}
