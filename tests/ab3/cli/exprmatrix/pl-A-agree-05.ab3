; pl-A-agree-05 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/pl-A-agree-05.bas: 56 of its 56 cells
; pl-A-agree-05.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vb.b=3 : vw.w=1000 : vl.l=100000 : vq.q=1.5 : vf.f=2.5
Statement pl{x.l}
  NPrint x
End Statement
Print "pl-mul-cf-f-A " : pl{1.5 * vf}
Print "pl-mul-cf-cb-A " : pl{1.5 * 3}
Print "pl-mul-cf-cw-A " : pl{1.5 * 1000}
Print "pl-mul-cf-cl-A " : pl{1.5 * 100000}
Print "pl-mul-cf-cf-A " : pl{1.5 * 1.5}
Print "pl-div-b-b-A " : pl{vb / vb}
Print "pl-div-b-w-A " : pl{vb / vw}
Print "pl-div-b-l-A " : pl{vb / vl}
Print "pl-div-b-f-A " : pl{vb / vf}
Print "pl-div-b-cb-A " : pl{vb / 3}
Print "pl-div-b-cw-A " : pl{vb / 1000}
Print "pl-div-b-cl-A " : pl{vb / 100000}
Print "pl-div-b-cf-A " : pl{vb / 1.5}
Print "pl-div-w-b-A " : pl{vw / vb}
Print "pl-div-w-w-A " : pl{vw / vw}
