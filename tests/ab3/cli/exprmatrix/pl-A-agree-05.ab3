Print "pl-div-q-cl-A " : pl{vq / 100000}
Print "pl-div-f-b-A " : pl{vf / vb}
Print "pl-div-f-w-A " : pl{vf / vw}
Print "pl-div-f-l-A " : pl{vf / vl}
Print "pl-div-f-q-A " : pl{vf / vq}
Print "pl-div-f-f-A " : pl{vf / vf}
Print "pl-div-f-cb-A " : pl{vf / 3}
Print "pl-div-f-cw-A " : pl{vf / 1000}
Print "pl-div-f-cl-A " : pl{vf / 100000}
Print "pl-div-f-cf-A " : pl{vf / 1.5}
Print "pl-div-cb-b-A " : pl{3 / vb}
