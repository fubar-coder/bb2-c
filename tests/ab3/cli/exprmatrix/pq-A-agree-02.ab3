; do not edit
vb.b=3 : vw.w=1000 : vl.l=100000 : vq.q=1.5 : vf.f=2.5
tq.q=0
Statement pq{x.q}
  SHARED tq
  tq=x : NPrint Hex$(Peek.l(&tq))
End Statement
Print "pq-sub-b-b-A " : pq{vb - vb}
Print "pq-sub-b-w-A " : pq{vb - vw}
Print "pq-sub-b-q-A " : pq{vb - vq}
