; i1-I-u-agree-03 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/i1-I-u-agree-03.bas: 56 of its 56 cells
; i1-I-u-agree-03.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vb.b=3 : vw.w=20 : vl.l=30 : vq.q=1.5 : vf.f=2.5
Dim ia.l(300)
For ii.l=0 To 300 : ia(ii)=ii*16+1 : Next
NPrint "i1-mul-f-l-I ",ia(vf * vl)
NPrint "i1-mul-f-q-I ",ia(vf * vq)
NPrint "i1-mul-f-f-I ",ia(vf * vf)
NPrint "i1-mul-f-cb-I ",ia(vf * 3)
NPrint "i1-mul-f-cf-I ",ia(vf * 1.5)
NPrint "i1-mul-cb-b-I ",ia(3 * vb)
NPrint "i1-mul-cb-w-I ",ia(3 * vw)
NPrint "i1-mul-cb-l-I ",ia(3 * vl)
NPrint "i1-mul-cb-f-I ",ia(3 * vf)
NPrint "i1-mul-cb-cb-I ",ia(3 * 3)
NPrint "i1-mul-cb-cf-I ",ia(3 * 1.5)
NPrint "i1-mul-cw-cf-I ",ia(200 * 1.5)
NPrint "i1-mul-cf-b-I ",ia(1.5 * vb)
NPrint "i1-mul-cf-w-I ",ia(1.5 * vw)
NPrint "i1-mul-cf-l-I ",ia(1.5 * vl)
NPrint "i1-mul-cf-q-I ",ia(1.5 * vq)
NPrint "i1-mul-cf-f-I ",ia(1.5 * vf)
NPrint "i1-mul-cf-cb-I ",ia(1.5 * 3)
NPrint "i1-mul-cf-cw-I ",ia(1.5 * 200)
NPrint "i1-mul-cf-cf-I ",ia(1.5 * 1.5)
NPrint "i1-div-b-b-I ",ia(vb / vb)
NPrint "i1-div-b-w-I ",ia(vb / vw)
NPrint "i1-div-b-l-I ",ia(vb / vl)
NPrint "i1-div-b-f-I ",ia(vb / vf)
NPrint "i1-div-b-cb-I ",ia(vb / 3)
NPrint "i1-div-b-cw-I ",ia(vb / 200)
NPrint "i1-div-b-cl-I ",ia(vb / 40000)
NPrint "i1-div-b-cf-I ",ia(vb / 1.5)
NPrint "i1-div-w-b-I ",ia(vw / vb)
NPrint "i1-div-w-w-I ",ia(vw / vw)
NPrint "i1-div-w-l-I ",ia(vw / vl)
NPrint "i1-div-w-f-I ",ia(vw / vf)
NPrint "i1-div-w-cb-I ",ia(vw / 3)
NPrint "i1-div-w-cw-I ",ia(vw / 200)
NPrint "i1-div-w-cl-I ",ia(vw / 40000)
NPrint "i1-div-w-cf-I ",ia(vw / 1.5)
NPrint "i1-div-l-b-I ",ia(vl / vb)
NPrint "i1-div-l-w-I ",ia(vl / vw)
NPrint "i1-div-l-l-I ",ia(vl / vl)
NPrint "i1-div-l-f-I ",ia(vl / vf)
NPrint "i1-div-l-cb-I ",ia(vl / 3)
NPrint "i1-div-l-cw-I ",ia(vl / 200)
NPrint "i1-div-l-cl-I ",ia(vl / 40000)
NPrint "i1-div-l-cf-I ",ia(vl / 1.5)
NPrint "i1-div-q-b-I ",ia(vq / vb)
NPrint "i1-div-q-w-I ",ia(vq / vw)
NPrint "i1-div-q-l-I ",ia(vq / vl)
NPrint "i1-div-q-q-I ",ia(vq / vq)
NPrint "i1-div-q-f-I ",ia(vq / vf)
NPrint "i1-div-q-cb-I ",ia(vq / 3)
NPrint "i1-div-q-cw-I ",ia(vq / 200)
NPrint "i1-div-q-cl-I ",ia(vq / 40000)
NPrint "i1-div-f-b-I ",ia(vf / vb)
NPrint "i1-div-f-w-I ",ia(vf / vw)
NPrint "i1-div-f-l-I ",ia(vf / vl)
NPrint "i1-div-f-q-I ",ia(vf / vq)
End
