; dq-B-fix199-01 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/dq-B-fix199-01.bas: 13 of its 13 cells
; dq-B-fix199-01.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vb.b=-3 : vw.w=-1000 : vl.l=-100000
rq.q=0
rq=vb * vl : NPrint "dq-mul-b-l-B ",Hex$(Peek.l(&rq))
rq=vw * vw : NPrint "dq-mul-w-w-B ",Hex$(Peek.l(&rq))
rq=vw * vl : NPrint "dq-mul-w-l-B ",Hex$(Peek.l(&rq))
rq=vw * -1000 : NPrint "dq-mul-w-cw-B ",Hex$(Peek.l(&rq))
rq=vl * vb : NPrint "dq-mul-l-b-B ",Hex$(Peek.l(&rq))
rq=vl * vw : NPrint "dq-mul-l-w-B ",Hex$(Peek.l(&rq))
rq=vl * vl : NPrint "dq-mul-l-l-B ",Hex$(Peek.l(&rq))
rq=vl * -3 : NPrint "dq-mul-l-cb-B ",Hex$(Peek.l(&rq))
rq=vl * -1000 : NPrint "dq-mul-l-cw-B ",Hex$(Peek.l(&rq))
rq=-3 * vl : NPrint "dq-mul-cb-l-B ",Hex$(Peek.l(&rq))
rq=-1000 * vw : NPrint "dq-mul-cw-w-B ",Hex$(Peek.l(&rq))
rq=-1000 * vl : NPrint "dq-mul-cw-l-B ",Hex$(Peek.l(&rq))
rq=-1000 * -1000 : NPrint "dq-mul-cw-cw-B ",Hex$(Peek.l(&rq))
End
