; do not edit
vb.b=3 : vw.w=1000 : vl.l=100000 : vq.q=1.5 : vf.f=2.5
tf.f=0
Statement pf{x.f}
  SHARED tf
  tf=x : NPrint Hex$(Peek.l(&tf))
End Statement
Print "pf-div-q-w-A " : pf{vq / vw}
Print "pf-div-q-l-A " : pf{vq / vl}
