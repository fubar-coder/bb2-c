; pf-B-agree-06 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/pf-B-agree-06.bas: 56 of its 56 cells
; pf-B-agree-06.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vb.b=-3 : vw.w=-1000 : vl.l=-100000 : vq.q=-1.5 : vf.f=-2.5
tf.f=0
Statement pf{x.f}
  SHARED tf
  tf=x : NPrint Hex$(Peek.l(&tf))
End Statement
Print "pf-div-q-w-B " : pf{vq / vw}
Print "pf-div-q-l-B " : pf{vq / vl}
Print "pf-div-q-q-B " : pf{vq / vq}
Print "pf-div-q-f-B " : pf{vq / vf}
