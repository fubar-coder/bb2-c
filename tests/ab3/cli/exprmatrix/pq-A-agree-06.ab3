; do not edit
vb.b=3 : vw.w=1000 : vl.l=100000
nb.b=2 : nw.w=2 : nl.l=2
tq.q=0
Statement pq{x.q}
  SHARED tq
  tq=x : NPrint Hex$(Peek.l(&tq))
End Statement
Print "pq-eor-w-w-A " : pq{vw EOR vw}
