; do not edit
vb.b=3 : vw.w=1000 : vq.q=1.5 : vf.f=2.5
tq.q=0
Statement pq{x.q}
  SHARED tq
  tq=x : NPrint Hex$(Peek.l(&tq))
End Statement
Print "pq-neg-b-A " : pq{-vb}
Print "pq-neg-w-A " : pq{-vw}
