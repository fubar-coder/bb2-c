; db-B-fix1177-01 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/db-B-fix1177-01.bas: 8 of its 8 cells
; db-B-fix1177-01.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries);
; db-B-fix1177-01.ref.expect: AmiBlitz3's measured output, 4 cells
; differ (docs/ab3/variant.md)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vl.l=-100000 : vq.q=-1.5
rb.b=0
rb=(-1.5 = vq) : NPrint "db-eq-cf-q-B ",rb
rb=(-1.5 <> vq) : NPrint "db-ne-cf-q-B ",rb
rb=(vq < vl) : NPrint "db-lt-q-l-B ",rb
rb=(vq <= vl) : NPrint "db-le-q-l-B ",rb
rb=(-1.5 <= vq) : NPrint "db-le-cf-q-B ",rb
rb=(vq > vl) : NPrint "db-gt-q-l-B ",rb
rb=(-1.5 > vq) : NPrint "db-gt-cf-q-B ",rb
rb=(vq >= vl) : NPrint "db-ge-q-l-B ",rb
End
