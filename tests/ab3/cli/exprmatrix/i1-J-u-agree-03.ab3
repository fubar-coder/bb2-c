NPrint "i1-div-cw-cf-J ",ia(-200 / -1.5)
NPrint "i1-div-cl-cw-J ",ia(-40000 / -200)
NPrint "i1-div-cl-cl-J ",ia(-40000 / -40000)
NPrint "i1-div-cf-b-J ",ia(-1.5 / vb)
NPrint "i1-div-cf-w-J ",ia(-1.5 / vw)
NPrint "i1-div-cf-l-J ",ia(-1.5 / vl)
NPrint "i1-div-cf-q-J ",ia(-1.5 / vq)
NPrint "i1-div-cf-f-J ",ia(-1.5 / vf)
NPrint "i1-div-cf-cb-J ",ia(-1.5 / -3)
NPrint "i1-div-cf-cw-J ",ia(-1.5 / -200)
