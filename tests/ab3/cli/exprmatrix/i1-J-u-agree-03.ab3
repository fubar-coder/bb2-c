NPrint "i1-div-f-cf-J ",ia(vf / -1.5)
NPrint "i1-div-cb-b-J ",ia(-3 / vb)
NPrint "i1-div-cb-w-J ",ia(-3 / vw)
NPrint "i1-div-cb-l-J ",ia(-3 / vl)
