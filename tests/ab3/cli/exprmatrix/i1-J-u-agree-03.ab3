NPrint "i1-div-cb-cw-J ",ia(-3 / -200)
NPrint "i1-div-cb-cl-J ",ia(-3 / -40000)
NPrint "i1-div-cb-cf-J ",ia(-3 / -1.5)
NPrint "i1-div-cw-b-J ",ia(-200 / vb)
NPrint "i1-div-cw-w-J ",ia(-200 / vw)
NPrint "i1-div-cw-l-J ",ia(-200 / vl)
NPrint "i1-div-cw-f-J ",ia(-200 / vf)
