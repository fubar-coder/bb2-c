; i1-J-u-agree-03 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/i1-J-u-agree-03.bas: 56 of its 56 cells
; i1-J-u-agree-03.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vb.b=-3 : vw.w=-20 : vl.l=-30 : vq.q=-1.5 : vf.f=-2.5
Dim ia.l(300)
For ii.l=0 To 300 : ia(ii)=ii*16+1 : Next
NPrint "i1-div-q-b-J ",ia(vq / vb)
NPrint "i1-div-q-w-J ",ia(vq / vw)
NPrint "i1-div-q-l-J ",ia(vq / vl)
