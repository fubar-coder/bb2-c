NPrint "i1-div-q-cf-J ",ia(vq / -1.5)
NPrint "i1-div-f-b-J ",ia(vf / vb)
NPrint "i1-div-f-w-J ",ia(vf / vw)
NPrint "i1-div-f-l-J ",ia(vf / vl)
