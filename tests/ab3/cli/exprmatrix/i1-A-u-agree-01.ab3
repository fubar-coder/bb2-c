; i1-A-u-agree-01 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/i1-A-u-agree-01.bas: 3 of its 3 cells
; i1-A-u-agree-01.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vs$="AB"
Dim ia.l(300)
For ii.l=0 To 300 : ia(ii)=ii*16+1 : Next
NPrint "i1-ne-s-s-A ",ia(vs$ <> vs$)
NPrint "i1-lt-s-s-A ",ia(vs$ < vs$)
NPrint "i1-gt-s-s-A ",ia(vs$ > vs$)
End
