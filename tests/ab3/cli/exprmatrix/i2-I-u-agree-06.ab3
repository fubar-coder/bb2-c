NPrint "i2-and-w-cw-I ",ja(1,vw AND 200)
NPrint "i2-and-w-cl-I ",ja(1,vw AND 40000)
NPrint "i2-and-l-b-I ",ja(1,vl AND vb)
NPrint "i2-and-l-w-I ",ja(1,vl AND vw)
NPrint "i2-and-l-l-I ",ja(1,vl AND vl)
NPrint "i2-and-l-cb-I ",ja(1,vl AND 3)
NPrint "i2-and-l-cw-I ",ja(1,vl AND 200)
NPrint "i2-and-l-cl-I ",ja(1,vl AND 40000)
NPrint "i2-and-cb-b-I ",ja(1,3 AND vb)
NPrint "i2-and-cb-w-I ",ja(1,3 AND vw)
NPrint "i2-and-cb-l-I ",ja(1,3 AND vl)
