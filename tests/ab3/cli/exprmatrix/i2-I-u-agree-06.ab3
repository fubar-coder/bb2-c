NPrint "i2-and-cb-cl-I ",ja(1,3 AND 40000)
NPrint "i2-and-cw-b-I ",ja(1,200 AND vb)
NPrint "i2-and-cw-w-I ",ja(1,200 AND vw)
NPrint "i2-and-cw-l-I ",ja(1,200 AND vl)
NPrint "i2-and-cw-cb-I ",ja(1,200 AND 3)
NPrint "i2-and-cw-cw-I ",ja(1,200 AND 200)
NPrint "i2-and-cw-cl-I ",ja(1,200 AND 40000)
NPrint "i2-and-cl-b-I ",ja(1,40000 AND vb)
NPrint "i2-and-cl-w-I ",ja(1,40000 AND vw)
