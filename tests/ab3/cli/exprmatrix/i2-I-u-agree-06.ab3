NPrint "i2-pow-cf-cl-I ",ja(1,1.5 ^ 2)
NPrint "i2-pow-cf-cf-I ",ja(1,1.5 ^ 2.5)
NPrint "i2-and-b-b-I ",ja(1,vb AND vb)
NPrint "i2-and-b-w-I ",ja(1,vb AND vw)
