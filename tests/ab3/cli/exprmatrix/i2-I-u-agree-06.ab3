; do not edit
vb.b=3 : vw.w=20 : vl.l=30
nb.b=2 : nw.w=2 : nl.l=2 : nq.q=2 : nf.f=2
Dim ja.l(1,300)
For ii.l=0 To 300 : ja(1,ii)=ii*16+1 : Next
NPrint "i2-pow-cf-b-I ",ja(1,1.5 ^ nb)
NPrint "i2-pow-cf-w-I ",ja(1,1.5 ^ nw)
