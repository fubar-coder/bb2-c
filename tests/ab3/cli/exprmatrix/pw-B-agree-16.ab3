; pw-B-agree-16 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/pw-B-agree-16.bas: 22 of its 22 cells
; pw-B-agree-16.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vb.b=-3 : vw.w=-1000 : vl.l=-100000 : vq.q=-1.5 : vf.f=-2.5
Statement pw{x.w}
  NPrint x
End Statement
Print "pw-ge-cw-cb-B " : pw{-1000 >= -3}
Print "pw-ge-cw-cw-B " : pw{-1000 >= -1000}
Print "pw-ge-cw-cl-B " : pw{-1000 >= -100000}
Print "pw-ge-cw-cf-B " : pw{-1000 >= -1.5}
Print "pw-ge-cl-b-B " : pw{-100000 >= vb}
Print "pw-ge-cl-w-B " : pw{-100000 >= vw}
Print "pw-ge-cl-l-B " : pw{-100000 >= vl}
Print "pw-ge-cl-q-B " : pw{-100000 >= vq}
Print "pw-ge-cl-f-B " : pw{-100000 >= vf}
Print "pw-ge-cl-cb-B " : pw{-100000 >= -3}
Print "pw-ge-cl-cw-B " : pw{-100000 >= -1000}
Print "pw-ge-cl-cl-B " : pw{-100000 >= -100000}
Print "pw-ge-cl-cf-B " : pw{-100000 >= -1.5}
Print "pw-ge-cf-b-B " : pw{-1.5 >= vb}
Print "pw-ge-cf-w-B " : pw{-1.5 >= vw}
Print "pw-ge-cf-l-B " : pw{-1.5 >= vl}
Print "pw-ge-cf-q-B " : pw{-1.5 >= vq}
Print "pw-ge-cf-f-B " : pw{-1.5 >= vf}
Print "pw-ge-cf-cb-B " : pw{-1.5 >= -3}
Print "pw-ge-cf-cw-B " : pw{-1.5 >= -1000}
Print "pw-ge-cf-cl-B " : pw{-1.5 >= -100000}
Print "pw-ge-cf-cf-B " : pw{-1.5 >= -1.5}
End
