vb.b=3 : vw.w=1000 : vl.l=100000
nb.b=2 : nw.w=2 : nl.l=2
Statement pl{x.l}
  NPrint x
End Statement
Print "pl-lsr-b-w-A " : pl{vb LSR nw}
