; do not edit
vb.b=-3 : vw.w=-1000 : vl.l=-100000 : vq.q=-1.5 : vf.f=-2.5
Statement pl{x.l}
  NPrint x
End Statement
Print "pl-mul-cf-q-B " : pl{-1.5 * vq}
