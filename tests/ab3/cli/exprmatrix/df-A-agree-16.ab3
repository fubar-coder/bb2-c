; df-A-agree-16 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/df-A-agree-16.bas: 21 of its 21 cells
; df-A-agree-16.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vb.b=3 : vw.w=1000 : vl.l=100000 : vq.q=1.5 : vf.f=2.5 : vs$="AB"
rf.f=0
rf=(100000 >= vq) : NPrint "df-ge-cl-q-A ",Hex$(Peek.l(&rf))
rf=(100000 >= vf) : NPrint "df-ge-cl-f-A ",Hex$(Peek.l(&rf))
rf=(100000 >= 3) : NPrint "df-ge-cl-cb-A ",Hex$(Peek.l(&rf))
rf=(100000 >= 1000) : NPrint "df-ge-cl-cw-A ",Hex$(Peek.l(&rf))
rf=(100000 >= 100000) : NPrint "df-ge-cl-cl-A ",Hex$(Peek.l(&rf))
rf=(100000 >= 1.5) : NPrint "df-ge-cl-cf-A ",Hex$(Peek.l(&rf))
rf=(1.5 >= vb) : NPrint "df-ge-cf-b-A ",Hex$(Peek.l(&rf))
rf=(1.5 >= vw) : NPrint "df-ge-cf-w-A ",Hex$(Peek.l(&rf))
rf=(1.5 >= vl) : NPrint "df-ge-cf-l-A ",Hex$(Peek.l(&rf))
rf=(1.5 >= vq) : NPrint "df-ge-cf-q-A ",Hex$(Peek.l(&rf))
rf=(1.5 >= vf) : NPrint "df-ge-cf-f-A ",Hex$(Peek.l(&rf))
rf=(1.5 >= 3) : NPrint "df-ge-cf-cb-A ",Hex$(Peek.l(&rf))
rf=(1.5 >= 1000) : NPrint "df-ge-cf-cw-A ",Hex$(Peek.l(&rf))
rf=(1.5 >= 100000) : NPrint "df-ge-cf-cl-A ",Hex$(Peek.l(&rf))
rf=(1.5 >= 1.5) : NPrint "df-ge-cf-cf-A ",Hex$(Peek.l(&rf))
rf=(vs$ = vs$) : NPrint "df-eq-s-s-A ",Hex$(Peek.l(&rf))
rf=(vs$ <> vs$) : NPrint "df-ne-s-s-A ",Hex$(Peek.l(&rf))
rf=(vs$ < vs$) : NPrint "df-lt-s-s-A ",Hex$(Peek.l(&rf))
rf=(vs$ <= vs$) : NPrint "df-le-s-s-A ",Hex$(Peek.l(&rf))
rf=(vs$ > vs$) : NPrint "df-gt-s-s-A ",Hex$(Peek.l(&rf))
rf=(vs$ >= vs$) : NPrint "df-ge-s-s-A ",Hex$(Peek.l(&rf))
End
