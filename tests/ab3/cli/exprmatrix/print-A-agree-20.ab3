; print-A-agree-20 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/print-A-agree-20.bas: 29 of its 29 cells
; print-A-agree-20.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vb.b=3 : vw.w=1000 : vl.l=100000 : vq.q=1.5 : vf.f=2.5 : vs$="AB"
NPrint "print-ge-cl-b-A ",100000 >= vb
NPrint "print-ge-cl-w-A ",100000 >= vw
NPrint "print-ge-cl-l-A ",100000 >= vl
NPrint "print-ge-cl-q-A ",100000 >= vq
NPrint "print-ge-cl-f-A ",100000 >= vf
NPrint "print-ge-cl-cb-A ",100000 >= 3
NPrint "print-ge-cl-cw-A ",100000 >= 1000
NPrint "print-ge-cl-cl-A ",100000 >= 100000
NPrint "print-ge-cl-cf-A ",100000 >= 1.5
NPrint "print-ge-cf-b-A ",1.5 >= vb
NPrint "print-ge-cf-w-A ",1.5 >= vw
NPrint "print-ge-cf-l-A ",1.5 >= vl
NPrint "print-ge-cf-q-A ",1.5 >= vq
NPrint "print-ge-cf-f-A ",1.5 >= vf
NPrint "print-ge-cf-cb-A ",1.5 >= 3
NPrint "print-ge-cf-cw-A ",1.5 >= 1000
NPrint "print-ge-cf-cl-A ",1.5 >= 100000
NPrint "print-ge-cf-cf-A ",1.5 >= 1.5
NPrint "print-add-s-s-A ",vs$ + vs$
NPrint "print-eq-s-s-A ",vs$ = vs$
NPrint "print-ne-s-s-A ",vs$ <> vs$
NPrint "print-lt-s-s-A ",vs$ < vs$
NPrint "print-le-s-s-A ",vs$ <= vs$
NPrint "print-gt-s-s-A ",vs$ > vs$
NPrint "print-ge-s-s-A ",vs$ >= vs$
NPrint "print-mod-cb-cb-A ",3 MOD 3
NPrint "print-mod-cb-cw-A ",3 MOD 1000
NPrint "print-mod-cw-cb-A ",1000 MOD 3
NPrint "print-mod-cw-cw-A ",1000 MOD 1000
End
