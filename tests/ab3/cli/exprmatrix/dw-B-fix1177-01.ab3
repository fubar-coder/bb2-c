; dw-B-fix1177-01 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/dw-B-fix1177-01.bas: 4 of its 4 cells
; dw-B-fix1177-01.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries);
; dw-B-fix1177-01.ref.expect: AmiBlitz3's measured output, 4 cells
; differ (docs/ab3/variant.md)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vl.l=-100000 : vq.q=-1.5
rw.w=0
rw=(vq < vl) : NPrint "dw-lt-q-l-B ",rw
rw=(vq <= vl) : NPrint "dw-le-q-l-B ",rw
rw=(vq > vl) : NPrint "dw-gt-q-l-B ",rw
rw=(vq >= vl) : NPrint "dw-ge-q-l-B ",rw
End
