NPrint "i2-add-cf-cw-I ",ja(1,1.5 + 200)
NPrint "i2-add-cf-cf-I ",ja(1,1.5 + 1.5)
NPrint "i2-sub-b-b-I ",ja(1,vb - vb)
NPrint "i2-sub-b-q-I ",ja(1,vb - vq)
NPrint "i2-sub-b-f-I ",ja(1,vb - vf)
NPrint "i2-sub-b-cb-I ",ja(1,vb - 3)
NPrint "i2-sub-b-cf-I ",ja(1,vb - 1.5)
NPrint "i2-sub-w-b-I ",ja(1,vw - vb)
NPrint "i2-sub-w-w-I ",ja(1,vw - vw)
