NPrint "i2-sub-w-f-I ",ja(1,vw - vf)
NPrint "i2-sub-w-cb-I ",ja(1,vw - 3)
NPrint "i2-sub-w-cf-I ",ja(1,vw - 1.5)
NPrint "i2-sub-l-b-I ",ja(1,vl - vb)
NPrint "i2-sub-l-w-I ",ja(1,vl - vw)
NPrint "i2-sub-l-l-I ",ja(1,vl - vl)
NPrint "i2-sub-l-f-I ",ja(1,vl - vf)
NPrint "i2-sub-l-cb-I ",ja(1,vl - 3)
NPrint "i2-sub-l-cf-I ",ja(1,vl - 1.5)
NPrint "i2-sub-q-q-I ",ja(1,vq - vq)
NPrint "i2-sub-q-cf-I ",ja(1,vq - 1.5)
NPrint "i2-sub-f-b-I ",ja(1,vf - vb)
NPrint "i2-sub-f-q-I ",ja(1,vf - vq)
NPrint "i2-sub-f-f-I ",ja(1,vf - vf)
NPrint "i2-sub-f-cb-I ",ja(1,vf - 3)
NPrint "i2-sub-f-cf-I ",ja(1,vf - 1.5)
NPrint "i2-sub-cb-b-I ",ja(1,3 - vb)
NPrint "i2-sub-cb-q-I ",ja(1,3 - vq)
NPrint "i2-sub-cb-f-I ",ja(1,3 - vf)
NPrint "i2-sub-cb-cb-I ",ja(1,3 - 3)
NPrint "i2-sub-cb-cf-I ",ja(1,3 - 1.5)
NPrint "i2-sub-cw-b-I ",ja(1,200 - vb)
NPrint "i2-sub-cw-w-I ",ja(1,200 - vw)
NPrint "i2-sub-cw-l-I ",ja(1,200 - vl)
NPrint "i2-sub-cw-q-I ",ja(1,200 - vq)
NPrint "i2-sub-cw-f-I ",ja(1,200 - vf)
NPrint "i2-sub-cw-cb-I ",ja(1,200 - 3)
NPrint "i2-sub-cw-cw-I ",ja(1,200 - 200)
NPrint "i2-sub-cw-cf-I ",ja(1,200 - 1.5)
NPrint "i2-sub-cl-cl-I ",ja(1,40000 - 40000)
NPrint "i2-sub-cf-q-I ",ja(1,1.5 - vq)
NPrint "i2-sub-cf-cf-I ",ja(1,1.5 - 1.5)
NPrint "i2-mul-b-b-I ",ja(1,vb * vb)
NPrint "i2-mul-b-w-I ",ja(1,vb * vw)
NPrint "i2-mul-b-l-I ",ja(1,vb * vl)
NPrint "i2-mul-b-q-I ",ja(1,vb * vq)
NPrint "i2-mul-b-f-I ",ja(1,vb * vf)
NPrint "i2-mul-b-cb-I ",ja(1,vb * 3)
NPrint "i2-mul-b-cf-I ",ja(1,vb * 1.5)
NPrint "i2-mul-w-b-I ",ja(1,vw * vb)
