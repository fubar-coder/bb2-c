; do not edit
vb.b=3 : vw.w=20 : vl.l=30 : vq.q=1.5 : vf.f=2.5
Dim ja.l(1,300)
For ii.l=0 To 300 : ja(1,ii)=ii*16+1 : Next
NPrint "i2-add-cf-w-I ",ja(1,1.5 + vw)
NPrint "i2-add-cf-l-I ",ja(1,1.5 + vl)
NPrint "i2-add-cf-q-I ",ja(1,1.5 + vq)
