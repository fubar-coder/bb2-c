; db-A-agree-14 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/db-A-agree-14.bas: 22 of its 22 cells
; db-A-agree-14.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vb.b=3 : vw.w=1000 : vl.l=100000 : vf.f=2.5 : vs$="AB"
rb.b=0
rb=(100000 >= 3) : NPrint "db-ge-cl-cb-A ",rb
rb=(100000 >= 1000) : NPrint "db-ge-cl-cw-A ",rb
rb=(100000 >= 100000) : NPrint "db-ge-cl-cl-A ",rb
rb=(100000 >= 1.5) : NPrint "db-ge-cl-cf-A ",rb
rb=(1.5 >= vb) : NPrint "db-ge-cf-b-A ",rb
rb=(1.5 >= vw) : NPrint "db-ge-cf-w-A ",rb
rb=(1.5 >= vl) : NPrint "db-ge-cf-l-A ",rb
rb=(1.5 >= vf) : NPrint "db-ge-cf-f-A ",rb
rb=(1.5 >= 3) : NPrint "db-ge-cf-cb-A ",rb
rb=(1.5 >= 1000) : NPrint "db-ge-cf-cw-A ",rb
rb=(1.5 >= 100000) : NPrint "db-ge-cf-cl-A ",rb
rb=(1.5 >= 1.5) : NPrint "db-ge-cf-cf-A ",rb
rb=(vs$ = vs$) : NPrint "db-eq-s-s-A ",rb
rb=(vs$ <> vs$) : NPrint "db-ne-s-s-A ",rb
rb=(vs$ < vs$) : NPrint "db-lt-s-s-A ",rb
rb=(vs$ <= vs$) : NPrint "db-le-s-s-A ",rb
rb=(vs$ > vs$) : NPrint "db-gt-s-s-A ",rb
rb=(vs$ >= vs$) : NPrint "db-ge-s-s-A ",rb
rb=3 MOD 3 : NPrint "db-mod-cb-cb-A ",rb
rb=3 MOD 1000 : NPrint "db-mod-cb-cw-A ",rb
rb=1000 MOD 3 : NPrint "db-mod-cw-cb-A ",rb
rb=1000 MOD 1000 : NPrint "db-mod-cw-cw-A ",rb
End
