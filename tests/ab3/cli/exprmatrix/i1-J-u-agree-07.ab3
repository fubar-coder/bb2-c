NPrint "i1-gt-q-q-J ",ia(vq > vq)
NPrint "i1-gt-q-cf-J ",ia(vq > -1.5)
NPrint "i1-gt-f-q-J ",ia(vf > vq)
NPrint "i1-gt-f-f-J ",ia(vf > vf)
