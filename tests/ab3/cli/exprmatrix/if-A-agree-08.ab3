; do not edit
vb.b=3 : vw.w=1000 : vl.l=100000
nb.b=2 : nw.w=2 : nl.l=2
If 3 OR 3 Then NPrint "if-or-cb-cb-A T" Else NPrint "if-or-cb-cb-A F"
