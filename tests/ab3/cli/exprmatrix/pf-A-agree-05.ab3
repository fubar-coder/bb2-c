; do not edit
vb.b=3 : vw.w=1000 : vl.l=100000 : vq.q=1.5 : vf.f=2.5
tf.f=0
Statement pf{x.f}
  SHARED tf
  tf=x : NPrint Hex$(Peek.l(&tf))
End Statement
Print "pf-mul-cb-cf-A " : pf{3 * 1.5}
Print "pf-mul-cw-b-A " : pf{1000 * vb}
