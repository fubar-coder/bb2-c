; pw-B-fix1177-01 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/pw-B-fix1177-01.bas: 4 of its 4 cells
; pw-B-fix1177-01.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries);
; pw-B-fix1177-01.ref.expect: AmiBlitz3's measured output, 4 cells
; differ (docs/ab3/variant.md)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vl.l=-100000 : vq.q=-1.5
Statement pw{x.w}
  NPrint x
End Statement
Print "pw-lt-q-l-B " : pw{vq < vl}
Print "pw-le-q-l-B " : pw{vq <= vl}
Print "pw-gt-q-l-B " : pw{vq > vl}
Print "pw-ge-q-l-B " : pw{vq >= vl}
End
