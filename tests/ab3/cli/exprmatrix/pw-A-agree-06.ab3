Print "pw-and-cw-cl-A " : pw{1000 AND 100000}
Print "pw-and-cl-b-A " : pw{100000 AND vb}
Print "pw-and-cl-w-A " : pw{100000 AND vw}
Print "pw-and-cl-cb-A " : pw{100000 AND 3}
Print "pw-and-cl-cw-A " : pw{100000 AND 1000}
Print "pw-or-b-b-A " : pw{vb OR vb}
Print "pw-or-b-w-A " : pw{vb OR vw}
Print "pw-or-b-cb-A " : pw{vb OR 3}
Print "pw-or-b-cw-A " : pw{vb OR 1000}
Print "pw-or-w-b-A " : pw{vw OR vb}
