; do not edit
vb.b=3 : vw.w=1000 : vl.l=100000
nb.b=2 : nw.w=2 : nl.l=2 : nq.q=2 : nf.f=2
Statement pw{x.w}
  NPrint x
End Statement
Print "pw-pow-cf-b-A " : pw{1.5 ^ nb}
Print "pw-pow-cf-w-A " : pw{1.5 ^ nw}
Print "pw-pow-cf-l-A " : pw{1.5 ^ nl}
