Print "pw-and-l-b-A " : pw{vl AND vb}
Print "pw-and-l-w-A " : pw{vl AND vw}
Print "pw-and-l-cb-A " : pw{vl AND 3}
Print "pw-and-l-cw-A " : pw{vl AND 1000}
Print "pw-and-cb-b-A " : pw{3 AND vb}
Print "pw-and-cb-w-A " : pw{3 AND vw}
Print "pw-and-cb-l-A " : pw{3 AND vl}
Print "pw-and-cb-cb-A " : pw{3 AND 3}
