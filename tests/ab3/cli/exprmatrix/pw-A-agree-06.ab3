Print "pw-pow-cf-cb-A " : pw{1.5 ^ 2}
Print "pw-pow-cf-cw-A " : pw{1.5 ^ 2}
Print "pw-pow-cf-cl-A " : pw{1.5 ^ 2}
Print "pw-pow-cf-cf-A " : pw{1.5 ^ 2.5}
Print "pw-and-b-b-A " : pw{vb AND vb}
Print "pw-and-b-w-A " : pw{vb AND vw}
Print "pw-and-b-l-A " : pw{vb AND vl}
