NPrint "i1-ne-cl-cl-J ",ia(-40000 <> -40000)
NPrint "i1-ne-cf-q-J ",ia(-1.5 <> vq)
NPrint "i1-ne-cf-cf-J ",ia(-1.5 <> -1.5)
NPrint "i1-lt-b-b-J ",ia(vb < vb)
NPrint "i1-lt-b-w-J ",ia(vb < vw)
NPrint "i1-lt-b-l-J ",ia(vb < vl)
