; do not edit
vb.b=-3 : vw.w=-1000 : vl.l=-100000 : vq.q=-1.5 : vf.f=-2.5
NPrint "print-neg-b-B ",-vb
NPrint "print-neg-w-B ",-vw
NPrint "print-neg-l-B ",-vl
NPrint "print-neg-q-B ",-vq
NPrint "print-neg-f-B ",-vf
