; pl-A-agree-20 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/pl-A-agree-20.bas: 35 of its 35 cells
; pl-A-agree-20.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vb.b=3 : vw.w=1000 : vl.l=100000 : vq.q=1.5 : vf.f=2.5 : vs$="AB"
Statement pl{x.l}
  NPrint x
End Statement
Print "pl-ge-cb-cl-A " : pl{3 >= 100000}
Print "pl-ge-cb-cf-A " : pl{3 >= 1.5}
Print "pl-ge-cw-b-A " : pl{1000 >= vb}
Print "pl-ge-cw-w-A " : pl{1000 >= vw}
Print "pl-ge-cw-l-A " : pl{1000 >= vl}
Print "pl-ge-cw-q-A " : pl{1000 >= vq}
Print "pl-ge-cw-f-A " : pl{1000 >= vf}
Print "pl-ge-cw-cb-A " : pl{1000 >= 3}
Print "pl-ge-cw-cw-A " : pl{1000 >= 1000}
Print "pl-ge-cw-cl-A " : pl{1000 >= 100000}
Print "pl-ge-cw-cf-A " : pl{1000 >= 1.5}
Print "pl-ge-cl-b-A " : pl{100000 >= vb}
Print "pl-ge-cl-w-A " : pl{100000 >= vw}
Print "pl-ge-cl-l-A " : pl{100000 >= vl}
Print "pl-ge-cl-q-A " : pl{100000 >= vq}
Print "pl-ge-cl-f-A " : pl{100000 >= vf}
Print "pl-ge-cl-cb-A " : pl{100000 >= 3}
Print "pl-ge-cl-cw-A " : pl{100000 >= 1000}
Print "pl-ge-cl-cl-A " : pl{100000 >= 100000}
Print "pl-ge-cl-cf-A " : pl{100000 >= 1.5}
Print "pl-ge-cf-b-A " : pl{1.5 >= vb}
Print "pl-ge-cf-w-A " : pl{1.5 >= vw}
Print "pl-ge-cf-l-A " : pl{1.5 >= vl}
Print "pl-ge-cf-q-A " : pl{1.5 >= vq}
Print "pl-ge-cf-f-A " : pl{1.5 >= vf}
Print "pl-ge-cf-cb-A " : pl{1.5 >= 3}
Print "pl-ge-cf-cw-A " : pl{1.5 >= 1000}
Print "pl-ge-cf-cl-A " : pl{1.5 >= 100000}
Print "pl-ge-cf-cf-A " : pl{1.5 >= 1.5}
Print "pl-eq-s-s-A " : pl{vs$ = vs$}
Print "pl-ne-s-s-A " : pl{vs$ <> vs$}
Print "pl-lt-s-s-A " : pl{vs$ < vs$}
Print "pl-le-s-s-A " : pl{vs$ <= vs$}
Print "pl-gt-s-s-A " : pl{vs$ > vs$}
Print "pl-ge-s-s-A " : pl{vs$ >= vs$}
End
