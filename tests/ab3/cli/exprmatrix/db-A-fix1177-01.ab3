; db-A-fix1177-01 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/db-A-fix1177-01.bas: 8 of its 8 cells
; db-A-fix1177-01.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries);
; db-A-fix1177-01.ref.expect: AmiBlitz3's measured output, 4 cells
; differ (docs/ab3/variant.md)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vl.l=100000 : vq.q=1.5
rb.b=0
rb=(1.5 = vq) : NPrint "db-eq-cf-q-A ",rb
rb=(1.5 <> vq) : NPrint "db-ne-cf-q-A ",rb
rb=(vq < vl) : NPrint "db-lt-q-l-A ",rb
rb=(1.5 < vq) : NPrint "db-lt-cf-q-A ",rb
rb=(vq <= vl) : NPrint "db-le-q-l-A ",rb
rb=(vq > vl) : NPrint "db-gt-q-l-A ",rb
rb=(vq >= vl) : NPrint "db-ge-q-l-A ",rb
rb=(1.5 >= vq) : NPrint "db-ge-cf-q-A ",rb
End
