Print "pw-add-q-b-B " : pw{vq + vb}
Print "pw-add-q-w-B " : pw{vq + vw}
Print "pw-add-q-q-B " : pw{vq + vq}
Print "pw-add-q-f-B " : pw{vq + vf}
Print "pw-add-q-cb-B " : pw{vq + -3}
Print "pw-add-q-cw-B " : pw{vq + -1000}
Print "pw-add-q-cf-B " : pw{vq + -1.5}
Print "pw-add-f-b-B " : pw{vf + vb}
Print "pw-add-f-w-B " : pw{vf + vw}
Print "pw-add-f-q-B " : pw{vf + vq}
