Print "pw-add-f-cw-B " : pw{vf + -1000}
Print "pw-add-f-cf-B " : pw{vf + -1.5}
Print "pw-add-cb-b-B " : pw{-3 + vb}
Print "pw-add-cb-w-B " : pw{-3 + vw}
Print "pw-add-cb-q-B " : pw{-3 + vq}
Print "pw-add-cb-f-B " : pw{-3 + vf}
Print "pw-add-cb-cb-B " : pw{-3 + -3}
Print "pw-add-cb-cw-B " : pw{-3 + -1000}
