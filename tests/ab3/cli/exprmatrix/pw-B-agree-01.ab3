; pw-B-agree-01 - expression matrix, AmiBlitz3 case of
; tests/corpus/tests-exprmatrix/pw-B-agree-01.bas: 56 of its 56 cells
; pw-B-agree-01.expect: the output of blitz2-ab3 -r in AB3 mode (the
; port's compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vb.b=-3 : vw.w=-1000 : vq.q=-1.5 : vf.f=-2.5
Statement pw{x.w}
  NPrint x
End Statement
Print "pw-neg-b-B " : pw{-vb}
Print "pw-neg-w-B " : pw{-vw}
Print "pw-neg-q-B " : pw{-vq}
Print "pw-neg-f-B " : pw{-vf}
Print "pw-neg-cb-B " : pw{- -3}
Print "pw-neg-cw-B " : pw{- -1000}
Print "pw-neg-cf-B " : pw{- -1.5}
Print "pw-not-b-B " : pw{NOT vb}
Print "pw-not-w-B " : pw{NOT vw}
Print "pw-not-cb-B " : pw{NOT -3}
Print "pw-not-cw-B " : pw{NOT -1000}
Print "pw-add-b-b-B " : pw{vb + vb}
