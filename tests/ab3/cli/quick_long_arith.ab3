; a Quick under a Long type so far (#1178): the port computes with the
; fraction and rounds at the operator (+ - * down, / towards zero), in
; AB3 mode too; AmiBlitz3 v3.14.0 cuts the Quick first (quick_long_arith.ref.expect)
q.q=1.5 : p.q=2.75 : n.q=-1.5 : l.l=10 : z.q=30000.5 : big.l=100000
r.l=q*2 : NPrint r
r=l-q : NPrint r
r=l*q : NPrint r
r=l/n : NPrint r
r=q+p : NPrint r
r=q*p : NPrint r
r=-q : NPrint r
r=big*z : NPrint r
End
