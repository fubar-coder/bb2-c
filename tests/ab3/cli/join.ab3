; joining lines with @@: a parameter list over three lines (after a ',',
; the rest of the line ignored), at the start of a function's
; parameters, a line of a macro; in a string @@ stays
NPrint "a", @@
  "b", @@   ; a comment
  "c"
NPrint "x@@y"
NPrint Str$(@@
3)
Macro zm
NPrint "m", @@
"n"
End Macro
!zm
End
