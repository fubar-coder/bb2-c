; dq-b-fix199-01 - expression matrix, AmiBlitz3 test of
; tests/corpus/tests-exprmatrix/dq-B-fix199-01.bas: 13 of its 13 cells
; the checks have the values of blitz2-ab3 -r in AB3 mode (the port's
; compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
!TestCase{cells}
  vb.b=-3 : vw.w=-1000 : vl.l=-100000
  rq.q=0
  rq=vb * vl : !CheckEq{Peek.l(&rq),$93DFFFFF,"dq-mul-b-l-B"}
  rq=vw * vw : !CheckEq{Peek.l(&rq),$4240000F,"dq-mul-w-w-B"}
  rq=vw * vl : !CheckEq{Peek.l(&rq),$E0FFFE26,"dq-mul-w-l-B"}
  rq=vw * -1000 : !CheckEq{Peek.l(&rq),$4240000F,"dq-mul-w-cw-B"}
  rq=vl * vb : !CheckEq{Peek.l(&rq),$93DFFFFF,"dq-mul-l-b-B"}
  rq=vl * vw : !CheckEq{Peek.l(&rq),$E0FFFE26,"dq-mul-l-w-B"}
  rq=vl * vl : !CheckEq{Peek.l(&rq),$E400398B,"dq-mul-l-l-B"}
  rq=vl * -3 : !CheckEq{Peek.l(&rq),$93DFFFFF,"dq-mul-l-cb-B"}
  rq=vl * -1000 : !CheckEq{Peek.l(&rq),$E0FFFE26,"dq-mul-l-cw-B"}
  rq=-3 * vl : !CheckEq{Peek.l(&rq),$93DFFFFF,"dq-mul-cb-l-B"}
  rq=-1000 * vw : !CheckEq{Peek.l(&rq),$4240000F,"dq-mul-cw-w-B"}
  rq=-1000 * vl : !CheckEq{Peek.l(&rq),$E0FFFE26,"dq-mul-cw-l-B"}
  rq=-1000 * -1000 : !CheckEq{Peek.l(&rq),$4240000F,"dq-mul-cw-cw-B"}
!EndTestCase
