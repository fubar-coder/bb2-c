; i2-a-u-agree-01 - expression matrix, AmiBlitz3 test of
; tests/corpus/tests-exprmatrix/i2-A-u-agree-01.bas: 3 of its 3 cells
; the checks have the values of blitz2-ab3 -r in AB3 mode (the port's
; compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
!TestCase{cells}
  vs$="AB"
  Dim ja.l(1,300)
  For ii.l=0 To 300 : ja(1,ii)=ii*16+1 : Next
  vv.l=0
  vv=ja(1,vs$ <> vs$) : !CheckEq{vv,1,"i2-ne-s-s-A"}
  vv=ja(1,vs$ < vs$) : !CheckEq{vv,1,"i2-lt-s-s-A"}
  vv=ja(1,vs$ > vs$) : !CheckEq{vv,1,"i2-gt-s-s-A"}
!EndTestCase
