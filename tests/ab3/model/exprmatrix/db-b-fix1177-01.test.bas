; db-b-fix1177-01 - expression matrix, AmiBlitz3 test of
; tests/corpus/tests-exprmatrix/db-B-fix1177-01.bas: 8 of its 8 cells
; the checks have the values of blitz2-ab3 -r in AB3 mode (the port's
; compiler with AmiBlitz3's libraries); AmiBlitz3's measured values of 4
; cells differ, the deviations of its cells (db-b-fix1177-01.test.toml,
; docs/ab3/variant.md)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
!TestCase{cells}
  vl.l=-100000 : vq.q=-1.5
  rb.b=0
  rb=(-1.5 = vq) : !CheckEq{rb,-1,"db-eq-cf-q-B"}
  rb=(-1.5 <> vq) : !CheckEq{rb,0,"db-ne-cf-q-B"}
  rb=(vq < vl) : !CheckEq{rb,0,"db-lt-q-l-B"}
  rb=(vq <= vl) : !CheckEq{rb,0,"db-le-q-l-B"}
  rb=(-1.5 <= vq) : !CheckEq{rb,-1,"db-le-cf-q-B"}
  rb=(vq > vl) : !CheckEq{rb,-1,"db-gt-q-l-B"}
  rb=(-1.5 > vq) : !CheckEq{rb,0,"db-gt-cf-q-B"}
  rb=(vq >= vl) : !CheckEq{rb,-1,"db-ge-q-l-B"}
!EndTestCase
