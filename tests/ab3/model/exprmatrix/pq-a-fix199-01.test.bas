; pq-a-fix199-01 - expression matrix, AmiBlitz3 test of
; tests/corpus/tests-exprmatrix/pq-A-fix199-01.bas: 13 of its 13 cells
; the checks have the values of blitz2-ab3 -r in AB3 mode (the port's
; compiler with AmiBlitz3's libraries)
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
DEFTYPE .q gq
Statement pq{x.q}
  SHARED gq
  gq=x
End Statement
!TestCase{cells}
  vb.b=3 : vw.w=1000 : vl.l=100000
  pq{vb * vl} : !CheckEq{Peek.l(&gq),$93DFFFFF,"pq-mul-b-l-A"}
  pq{vw * vw} : !CheckEq{Peek.l(&gq),$4240000F,"pq-mul-w-w-A"}
  pq{vw * vl} : !CheckEq{Peek.l(&gq),$E0FFFE26,"pq-mul-w-l-A"}
  pq{vw * 1000} : !CheckEq{Peek.l(&gq),$4240000F,"pq-mul-w-cw-A"}
  pq{vl * vb} : !CheckEq{Peek.l(&gq),$93DFFFFF,"pq-mul-l-b-A"}
  pq{vl * vw} : !CheckEq{Peek.l(&gq),$E0FFFE26,"pq-mul-l-w-A"}
  pq{vl * vl} : !CheckEq{Peek.l(&gq),$E400398B,"pq-mul-l-l-A"}
  pq{vl * 3} : !CheckEq{Peek.l(&gq),$93DFFFFF,"pq-mul-l-cb-A"}
  pq{vl * 1000} : !CheckEq{Peek.l(&gq),$E0FFFE26,"pq-mul-l-cw-A"}
  pq{3 * vl} : !CheckEq{Peek.l(&gq),$93DFFFFF,"pq-mul-cb-l-A"}
  pq{1000 * vw} : !CheckEq{Peek.l(&gq),$4240000F,"pq-mul-cw-w-A"}
  pq{1000 * vl} : !CheckEq{Peek.l(&gq),$E0FFFE26,"pq-mul-cw-l-A"}
  pq{1000 * 1000} : !CheckEq{Peek.l(&gq),$4240000F,"pq-mul-cw-cw-A"}
!EndTestCase
