; i2-I-c-fix1177-01 - expression matrix: context i2, value set I,
; runtime error checking on, 4 cells
; fixed cells of #1177 (a comparison is computed in the type so far of
; its context, not with its operands' own values):
; i2-I-c-fix1177-01.orig.out the original's value,
; i2-I-c-fix1177-01.fixed-1177.out the port's
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vq.q=1.5
Dim ja.l(1,300)
For ii.l=0 To 300 : ja(1,ii)=ii*16+1 : Next
SetErr : NPrint "i2-eq-q-cf-I !runtime" : Goto mx1 : End SetErr
NPrint "i2-eq-q-cf-I ",ja(1,vq = 1.5)
mx1:
SetErr : NPrint "i2-ne-q-cf-I !runtime" : Goto mx2 : End SetErr
NPrint "i2-ne-q-cf-I ",ja(1,vq <> 1.5)
mx2:
SetErr : NPrint "i2-lt-q-cf-I !runtime" : Goto mx3 : End SetErr
NPrint "i2-lt-q-cf-I ",ja(1,vq < 1.5)
mx3:
SetErr : NPrint "i2-ge-q-cf-I !runtime" : Goto mx4 : End SetErr
NPrint "i2-ge-q-cf-I ",ja(1,vq >= 1.5)
mx4:
End
