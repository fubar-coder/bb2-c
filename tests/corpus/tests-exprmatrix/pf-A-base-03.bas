; pf-A-base-03 - expression matrix: context pf, value set A, 14 cells
; baseline cells (the original's measured value): no recorded rule covers them, the
; value is kept as a regression check, not as a decision that it is right
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
nb.b=2 : nw.w=2 : nl.l=2 : nq.q=2 : nf.f=2
tf.f=0
Statement pf{x.f}
  SHARED tf
  tf=x : NPrint Hex$(Peek.l(&tf))
End Statement
Print "pf-pow-cl-f-A " : pf{100000 ^ nf}
Print "pf-pow-cl-cb-A " : pf{100000 ^ 2}
Print "pf-pow-cl-cw-A " : pf{100000 ^ 2}
Print "pf-pow-cl-cl-A " : pf{100000 ^ 2}
Print "pf-pow-cl-cf-A " : pf{100000 ^ 2.5}
Print "pf-pow-cf-b-A " : pf{1.5 ^ nb}
Print "pf-pow-cf-w-A " : pf{1.5 ^ nw}
Print "pf-pow-cf-l-A " : pf{1.5 ^ nl}
Print "pf-pow-cf-q-A " : pf{1.5 ^ nq}
Print "pf-pow-cf-f-A " : pf{1.5 ^ nf}
Print "pf-pow-cf-cb-A " : pf{1.5 ^ 2}
Print "pf-pow-cf-cw-A " : pf{1.5 ^ 2}
Print "pf-pow-cf-cl-A " : pf{1.5 ^ 2}
Print "pf-pow-cf-cf-A " : pf{1.5 ^ 2.5}
End
