; pq-A-base-10 - expression matrix: context pq, value set A, 16 cells
; baseline cells (the original's measured value): no recorded rule covers them, the
; value is kept as a regression check, not as a decision that it is right
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
nb.b=2 : nw.w=2 : nl.l=2 : nq.q=2
tq.q=0
Statement pq{x.q}
  SHARED tq
  tq=x : NPrint Hex$(Peek.l(&tq))
End Statement
Print "pq-asr-cw-q-A " : pq{1000 ASR nq}
Print "pq-asr-cw-cf-A " : pq{1000 ASR 2.5}
Print "pq-asr-cl-q-A " : pq{100000 ASR nq}
Print "pq-asr-cf-b-A " : pq{1.5 ASR nb}
Print "pq-asr-cf-w-A " : pq{1.5 ASR nw}
Print "pq-asr-cf-l-A " : pq{1.5 ASR nl}
Print "pq-asr-cf-q-A " : pq{1.5 ASR nq}
Print "pq-asr-cf-cb-A " : pq{1.5 ASR 2}
Print "pq-asr-cf-cw-A " : pq{1.5 ASR 2}
Print "pq-asr-cf-cl-A " : pq{1.5 ASR 2}
Print "pq-asr-cf-cf-A " : pq{1.5 ASR 2.5}
Print "pq-mod-cb-cf-A " : pq{3 MOD 1.5}
Print "pq-mod-cw-cf-A " : pq{1000 MOD 1.5}
Print "pq-mod-cf-cb-A " : pq{1.5 MOD 3}
Print "pq-mod-cf-cw-A " : pq{1.5 MOD 1000}
Print "pq-mod-cf-cf-A " : pq{1.5 MOD 1.5}
End
