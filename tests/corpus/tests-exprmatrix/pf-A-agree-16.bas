; pf-A-agree-16 - expression matrix: context pf, value set A, 21 cells
; agreement cells: the value a recorded rule or the exact result gives, which the
; originals and the port give
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vb.b=3 : vw.w=1000 : vl.l=100000 : vq.q=1.5 : vf.f=2.5 : vs$="AB"
tf.f=0
Statement pf{x.f}
  SHARED tf
  tf=x : NPrint Hex$(Peek.l(&tf))
End Statement
Print "pf-ge-cl-q-A " : pf{100000 >= vq}
Print "pf-ge-cl-f-A " : pf{100000 >= vf}
Print "pf-ge-cl-cb-A " : pf{100000 >= 3}
Print "pf-ge-cl-cw-A " : pf{100000 >= 1000}
Print "pf-ge-cl-cl-A " : pf{100000 >= 100000}
Print "pf-ge-cl-cf-A " : pf{100000 >= 1.5}
Print "pf-ge-cf-b-A " : pf{1.5 >= vb}
Print "pf-ge-cf-w-A " : pf{1.5 >= vw}
Print "pf-ge-cf-l-A " : pf{1.5 >= vl}
Print "pf-ge-cf-q-A " : pf{1.5 >= vq}
Print "pf-ge-cf-f-A " : pf{1.5 >= vf}
Print "pf-ge-cf-cb-A " : pf{1.5 >= 3}
Print "pf-ge-cf-cw-A " : pf{1.5 >= 1000}
Print "pf-ge-cf-cl-A " : pf{1.5 >= 100000}
Print "pf-ge-cf-cf-A " : pf{1.5 >= 1.5}
Print "pf-eq-s-s-A " : pf{vs$ = vs$}
Print "pf-ne-s-s-A " : pf{vs$ <> vs$}
Print "pf-lt-s-s-A " : pf{vs$ < vs$}
Print "pf-le-s-s-A " : pf{vs$ <= vs$}
Print "pf-gt-s-s-A " : pf{vs$ > vs$}
Print "pf-ge-s-s-A " : pf{vs$ >= vs$}
End
