; pq-B-fix199-01 - expression matrix: context pq, value set B, 13 cells
; fixed cells of #199 (the CD's quickmult adds the high words' product
; beyond the Quick range): pq-B-fix199-01.orig.out the original's value,
; pq-B-fix199-01.fixed-199.out the port's
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vb.b=-3 : vw.w=-1000 : vl.l=-100000
tq.q=0
Statement pq{x.q}
  SHARED tq
  tq=x : NPrint Hex$(Peek.l(&tq))
End Statement
Print "pq-mul-b-l-B " : pq{vb * vl}
Print "pq-mul-w-w-B " : pq{vw * vw}
Print "pq-mul-w-l-B " : pq{vw * vl}
Print "pq-mul-w-cw-B " : pq{vw * -1000}
Print "pq-mul-l-b-B " : pq{vl * vb}
Print "pq-mul-l-w-B " : pq{vl * vw}
Print "pq-mul-l-l-B " : pq{vl * vl}
Print "pq-mul-l-cb-B " : pq{vl * -3}
Print "pq-mul-l-cw-B " : pq{vl * -1000}
Print "pq-mul-cb-l-B " : pq{-3 * vl}
Print "pq-mul-cw-w-B " : pq{-1000 * vw}
Print "pq-mul-cw-l-B " : pq{-1000 * vl}
Print "pq-mul-cw-cw-B " : pq{-1000 * -1000}
End
