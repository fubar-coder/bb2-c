NPrint "i1-mod-cb-b-J ",ia(-3 MOD vb)
NPrint "i1-mod-cb-cb-J ",ia(-3 MOD -3)
NPrint "i1-mod-cb-cf-J ",ia(-3 MOD -1.5)
NPrint "i1-mod-cw-w-J ",ia(-200 MOD vw)
NPrint "i1-mod-cw-q-J ",ia(-200 MOD vq)
NPrint "i1-mod-cw-f-J ",ia(-200 MOD vf)
NPrint "i1-mod-cw-cw-J ",ia(-200 MOD -200)
NPrint "i1-mod-cw-cf-J ",ia(-200 MOD -1.5)
NPrint "i1-mod-cl-w-J ",ia(-40000 MOD vw)
NPrint "i1-mod-cl-q-J ",ia(-40000 MOD vq)
