NPrint "i1-mod-l-b-J ",ia(vl MOD vb)
NPrint "i1-mod-l-l-J ",ia(vl MOD vl)
NPrint "i1-mod-l-q-J ",ia(vl MOD vq)
NPrint "i1-mod-l-f-J ",ia(vl MOD vf)
NPrint "i1-mod-l-cb-J ",ia(vl MOD -3)
NPrint "i1-mod-l-cf-J ",ia(vl MOD -1.5)
NPrint "i1-mod-q-q-J ",ia(vq MOD vq)
