; i2-J-c-base-08 - expression matrix: context i2, value set J, runtime
; error checking on, 10 cells
; baseline cells (the original's measured value): no recorded rule covers them, the
; value is kept as a regression check, not as a decision that it is right
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vq.q=-1.5
nb.b=3 : nw.w=3 : nl.l=3 : nq.q=3
Dim ja.l(1,300)
For ii.l=0 To 300 : ja(1,ii)=ii*16+1 : Next
SetErr : NPrint "i2-asr-q-b-J !runtime" : Goto mx1 : End SetErr
NPrint "i2-asr-q-b-J ",ja(1,vq ASR nb)
mx1:
SetErr : NPrint "i2-asr-q-w-J !runtime" : Goto mx2 : End SetErr
NPrint "i2-asr-q-w-J ",ja(1,vq ASR nw)
mx2:
SetErr : NPrint "i2-asr-q-l-J !runtime" : Goto mx3 : End SetErr
NPrint "i2-asr-q-l-J ",ja(1,vq ASR nl)
mx3:
SetErr : NPrint "i2-asr-q-q-J !runtime" : Goto mx4 : End SetErr
NPrint "i2-asr-q-q-J ",ja(1,vq ASR nq)
mx4:
SetErr : NPrint "i2-asr-q-cb-J !runtime" : Goto mx5 : End SetErr
NPrint "i2-asr-q-cb-J ",ja(1,vq ASR 3)
mx5:
SetErr : NPrint "i2-asr-q-cw-J !runtime" : Goto mx6 : End SetErr
NPrint "i2-asr-q-cw-J ",ja(1,vq ASR 3)
mx6:
SetErr : NPrint "i2-asr-q-cl-J !runtime" : Goto mx7 : End SetErr
NPrint "i2-asr-q-cl-J ",ja(1,vq ASR 3)
mx7:
SetErr : NPrint "i2-asr-cb-q-J !runtime" : Goto mx8 : End SetErr
NPrint "i2-asr-cb-q-J ",ja(1,-3 ASR nq)
mx8:
SetErr : NPrint "i2-asr-cw-q-J !runtime" : Goto mx9 : End SetErr
NPrint "i2-asr-cw-q-J ",ja(1,-200 ASR nq)
mx9:
SetErr : NPrint "i2-asr-cl-q-J !runtime" : Goto mx10 : End SetErr
NPrint "i2-asr-cl-q-J ",ja(1,-40000 ASR nq)
mx10:
End
