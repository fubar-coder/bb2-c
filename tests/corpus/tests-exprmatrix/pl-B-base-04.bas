; pl-B-base-04 - expression matrix: context pl, value set B, 8 cells
; baseline cells (the original's measured value): no recorded rule covers them, the
; value is kept as a regression check, not as a decision that it is right
; generated by exprmatrix expect from
; tests/corpus/tests-exprmatrix/matrix.txt (tools/exprmatrix/README.md);
; do not edit
vq.q=-1.5
nl.l=3 : nq.q=3
Statement pl{x.l}
  NPrint x
End Statement
Print "pl-asr-q-l-B " : pl{vq ASR nl}
Print "pl-asr-q-q-B " : pl{vq ASR nq}
Print "pl-asr-q-cb-B " : pl{vq ASR 3}
Print "pl-asr-q-cw-B " : pl{vq ASR 3}
Print "pl-asr-q-cl-B " : pl{vq ASR 3}
Print "pl-asr-cb-q-B " : pl{-3 ASR nq}
Print "pl-asr-cw-q-B " : pl{-1000 ASR nq}
Print "pl-asr-cl-q-B " : pl{-100000 ASR nq}
End
