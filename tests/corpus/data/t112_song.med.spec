; volumes 64, 46, 33) and a fourth slot without a sample, 4 blocks of 4
; tracks and 32 lines, a song of 8 positions (blocks 0 1 2 3 1 0 3 2),
; 2 ticks per line.  2 ticks per line keep the rows t112_med prints (every
; 6th pulse) on new lines in every phase: 400 and 60 pulses are whole
; lines.  Every line has a note on every track (instrument (block + track)
; MOD 3 + 1, note 13 + 8 * block + 3 * track + line MOD 6), except track 1
; in the lines 2, 6, 10, ...; block 0 line 3 track 3 has the command 0C
; (volume, decimal 32).
; A note (MMD0, 3 bytes): note, instrument number in the high nibble and
; the command in the low one, the command's data.
s "MMD0"
l @end                  ; module length
l @song
w 0 0                   ; psecnum, pseq
l @blockarr
b 0 0 0 0               ; flags, reserved
l @smplarr
l 0
l 0                     ; expansion data: none
l 0
w 0 0 0 0               ; pstate, pblock, pline, pseqnum
w 0                     ; actplayline
b 0 0                   ; counter, extra songs
song:
w 0 1                   ; sample 1: repeat, repeat length (none)
b 0 0 64 0              ;   MIDI channel, preset, volume, transpose
w 0 1                   ; sample 2
b 0 0 46 0
w 0 1                   ; sample 3
b 0 0 33 0
w 0 1                   ; sample 4: no sample data (smplarr entry 0)
b 0 0 64 0
fill 472 0              ; samples 5-63: none
w 4                     ; blocks
w 8                     ; song length
b 0 1 2 3 1 0 3 2       ; play sequence
fill 248 0
w 125                   ; tempo
b 0 0 0 2               ; transpose, flags, flags2, ticks per line
fill 16 64              ; track volumes
b 64 4                  ; master volume, samples
