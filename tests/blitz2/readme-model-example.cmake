# readme-model-example.cmake - the example of tests/README.md, "Tests that
# judge themselves": the blocks marked basic-test (the source) and
# basic-test-toml (its configuration) are written to WORK as
# readme-example.test.bas and readme-example.test.toml beside a root
# tests.toml, and every case of the source runs with corpusrun case on the
# side SIDE; each must pass (exit status 0; 77, skipped, is passed on).
#   cmake -DREADME=tests/README.md -DCORPUSRUN=corpusrun -DENV=model-env.toml
#         -DWORK=DIR -DSIDE=port|originals -P readme-model-example.cmake
foreach(v README CORPUSRUN ENV WORK SIDE)
	if(NOT DEFINED ${v} OR "${${v}}" STREQUAL "")
		message(FATAL_ERROR "readme-model-example.cmake: -D${v}=... missing")
	endif()
endforeach()
file(READ ${README} text)
# fenced_block(INFO VAR): the text of the one fenced block with the info string INFO
function(fenced_block info var)
	string(FIND "${text}" "```${info}\n" at)
	if(at LESS 0)
		message(FATAL_ERROR "${README}: no block ```${info}")
	endif()
	string(LENGTH "```${info}\n" skip)
	math(EXPR at "${at} + ${skip}")
	string(SUBSTRING "${text}" ${at} -1 rest)
	string(FIND "${rest}" "```${info}\n" again)
	if(NOT again LESS 0)
		message(FATAL_ERROR "${README}: two blocks ```${info}")
	endif()
	string(FIND "${rest}" "\n```\n" end)
	if(end LESS 0)
		message(FATAL_ERROR "${README}: the block ```${info} does not end")
	endif()
	math(EXPR end "${end} + 1")
	string(SUBSTRING "${rest}" 0 ${end} body)
	set(${var} "${body}" PARENT_SCOPE)
endfunction()
fenced_block(basic-test source)
fenced_block(basic-test-toml toml)
file(REMOVE_RECURSE ${WORK})
file(MAKE_DIRECTORY ${WORK})
file(WRITE ${WORK}/tests.toml "root = true\n")
file(WRITE ${WORK}/readme-example.test.bas "${source}")
file(WRITE ${WORK}/readme-example.test.toml "${toml}")
string(REGEX MATCHALL "\n!TestCase{[a-z][a-z0-9_]*}" cases "\n${source}")
if(NOT cases)
	message(FATAL_ERROR "${README}: the block ```basic-test has no case")
endif()
set(skipped FALSE)
foreach(c IN LISTS cases)
	string(REGEX REPLACE "^\n!TestCase{(.*)}$" "\\1" c "${c}")
	execute_process(COMMAND ${CORPUSRUN} case --env ${ENV} --source ${WORK}/readme-example.test.bas
		--case ${c} --side ${SIDE} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
	message(STATUS "case ${c}: exit status ${rc}\n${out}")
	if(rc EQUAL 77)
		set(skipped TRUE)
	elseif(NOT rc EQUAL 0)
		message(FATAL_ERROR "the example of ${README}: case ${c} does not pass (exit status ${rc})")
	endif()
endforeach()
if(skipped)
	cmake_language(EXIT 77)
endif()
file(REMOVE_RECURSE ${WORK})
message(STATUS "readme-model-example: every case passed")
