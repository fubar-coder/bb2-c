# Default: never touch file contents (Amiga files, resources, library files)
*                       -text

# our own text files
*.c                     text eol=lf
*.h                     text eol=lf
*.md                    text eol=lf
*.cmake                 text eol=lf
*.ld                    text eol=lf
*.uae                   text eol=lf
CMakeLists.txt          text eol=lf
CMakePresets.json       text eol=lf
.gitignore              text eol=lf
.gitattributes          text eol=lf

# the original sources of TED (unchanged copy): binary, the assembler
# sources get diffs but no conversion; prebuilt library files
/programs/ted/original/**   binary
/programs/ted/original/*.s  -text diff
*.obj                   binary
