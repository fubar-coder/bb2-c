# Default: never touch file contents (Amiga files, resources, library files)
*                       -text

# our own text files
*.c                     text eol=lf
*.h                     text eol=lf
*.md                    text eol=lf
*.cmake                 text eol=lf
*.ld                    text eol=lf
*.uae                   text eol=lf
CMakeLists.txt          text eol=lf
CMakePresets.json       text eol=lf
.gitignore              text eol=lf
.gitattributes          text eol=lf

# archive/: unchanged copies of original material - binary, the assembler
# sources get diffs but no conversion; prebuilt library files
/archive/**                 binary
/archive/**/*.s             -text diff
/archive/**/README.md       text eol=lf diff merge
LICENSE                     text eol=lf
RUNTIME-LIBRARY-EXCEPTION   text eol=lf
*.obj                   binary
